<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:local="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Beast.Radar.UI.Brushes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <sys:Double x:Key="Size.ScrollBar">17</sys:Double>
    <sys:Double x:Key="Size.GroupBox.Border">1</sys:Double>

    <Thickness x:Key="Border.Normal">0</Thickness>
    <Thickness x:Key="Border.Box">1</Thickness>
    <Thickness x:Key="Border.Over">2</Thickness>
    <Thickness x:Key="Border.Focus">2</Thickness>

    <Thickness x:Key="Margin.Focus.Uniform">-3</Thickness>
    <Thickness x:Key="Margin.Focus.Padded">-8,-3</Thickness>

    <CornerRadius x:Key="Corner.Border0">1.75</CornerRadius>
    <CornerRadius x:Key="Corner.Border0.Top">1.75,1.75,0,0</CornerRadius>
    <CornerRadius x:Key="Corner.Border0.Bottom">0,0,1.75,1.75</CornerRadius>
    <CornerRadius x:Key="Corner.Border0.Left">1.75,0,0,1.75</CornerRadius>
    <CornerRadius x:Key="Corner.Border0.Right">0,1.75,1.75,0</CornerRadius>
    <CornerRadius x:Key="Corner.Border1">1.25</CornerRadius>
    <CornerRadius x:Key="Corner.Border1.Top">1.25,1.25,0,0</CornerRadius>
    <CornerRadius x:Key="Corner.Border1.Bottom">0,0,1.25,1.25</CornerRadius>
    <CornerRadius x:Key="Corner.Border1.Left">1.25,0,0,1.25</CornerRadius>
    <CornerRadius x:Key="Corner.Border1.Right">0,1.25,1.25,0</CornerRadius>
    <CornerRadius x:Key="Corner.Border2">0.75</CornerRadius>
    <CornerRadius x:Key="Corner.Border2.Top">0.75,0.75,0,0</CornerRadius>
    <CornerRadius x:Key="Corner.Border2.Bottom">0,0,0.75,0.75</CornerRadius>
    <CornerRadius x:Key="Corner.Border2.Left">0.75,0,0,0.75</CornerRadius>
    <CornerRadius x:Key="Corner.Border2.Right">0,0.75,0.75,0</CornerRadius>
    <CornerRadius x:Key="Corner.Focus">0</CornerRadius>
    <CornerRadius x:Key="Corner.Popup">3</CornerRadius>


    <!--  Focus Styles  -->
    <Style TargetType="Control" x:Key="Style.Focus.Outer.Uniform">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Border
                        BorderBrush="{StaticResource Brush.Border.Focus}"
                        BorderThickness="{DynamicResource Border.Focus}"
                        CornerRadius="{DynamicResource Corner.Focus}"
                        Margin="{DynamicResource Margin.Focus.Uniform}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Control" x:Key="Style.Focus.Outer.Padded">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Border
                        BorderBrush="{StaticResource Brush.Border.Focus}"
                        BorderThickness="{DynamicResource Border.Focus}"
                        CornerRadius="{DynamicResource Corner.Focus}"
                        Margin="{DynamicResource Margin.Focus.Padded}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Control" x:Key="Style.Focus.Inner.Uniform">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Border
                        BorderBrush="{StaticResource Brush.Border.Focus}"
                        BorderThickness="{DynamicResource Border.Focus}"
                        CornerRadius="{DynamicResource Corner.Focus}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Base Control Styles  -->
    <Style x:Key="Style.Base">
        <Setter Property="Control.Foreground" Value="{StaticResource Brush.Foreground.Normal}" />
        <Setter Property="Control.HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Control.VerticalContentAlignment" Value="Stretch" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    </Style>
    <Style BasedOn="{StaticResource Style.Base}" TargetType="Control" />
    <Style BasedOn="{StaticResource Style.Base}" TargetType="ContentControl" />
    <Style BasedOn="{StaticResource Style.Base}" TargetType="HeaderedContentControl" />
    <Style BasedOn="{StaticResource Style.Base}" TargetType="ItemsControl">
        <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Style.Focus.Outer.Uniform}" />
    </Style>
    <Style BasedOn="{StaticResource Style.Base}" TargetType="HeaderedItemsControl">
        <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst" />
    </Style>
    <Style BasedOn="{StaticResource Style.Base}" TargetType="UserControl" />
    <Style BasedOn="{StaticResource Style.Base}" TargetType="Page" />
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource Brush.Background.Normal}" />
    </Style>

    <!--  Button/RepeatButton  -->
    <ControlTemplate TargetType="ButtonBase" x:Key="Template.ButtonBase">
        <Grid
            Opacity="{TemplateBinding Opacity}"
            RenderTransformOrigin="0.5,0.5"
            x:Name="TemplateRoot">
            <Grid.RenderTransform>
                <ScaleTransform />
            </Grid.RenderTransform>
            <Border
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{DynamicResource Corner.Border0}"
                x:Name="Border" />
            <ContentPresenter
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                Margin="{TemplateBinding Padding}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                x:Name="PART_ContentPresenter" />
        </Grid>
        <ControlTemplate.Resources>
            <Storyboard x:Key="Anim.Press">
                <DoubleAnimation
                    DecelerationRatio="0.25"
                    Duration="0:0:0.1"
                    Storyboard.TargetName="TemplateRoot"
                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                    To="0.99" />
                <DoubleAnimation
                    DecelerationRatio="0.25"
                    Duration="0:0:0.1"
                    Storyboard.TargetName="TemplateRoot"
                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                    To="0.99" />

            </Storyboard>
            <Storyboard x:Key="Anim.Release">
                <DoubleAnimation
                    DecelerationRatio="1"
                    Duration="0:0:0.2"
                    Storyboard.TargetName="TemplateRoot"
                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                    To="1" />
                <DoubleAnimation
                    DecelerationRatio="1"
                    Duration="0:0:0.2"
                    Storyboard.TargetName="TemplateRoot"
                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                    To="1" />
            </Storyboard>
        </ControlTemplate.Resources>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" TargetName="Border" Value="{StaticResource Brush.Border.Over}" />
                <Setter Property="BorderThickness" TargetName="Border" Value="{DynamicResource Border.Over}" />
                <Setter Property="CornerRadius" TargetName="Border" Value="{DynamicResource Corner.Border2}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource Anim.Press}" />
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource Anim.Release}" />
                </Trigger.ExitActions>
                <Setter Property="Opacity" TargetName="TemplateRoot" Value="0.75" />
            </Trigger>
            <Trigger Property="IsPressed" Value="False">
                <Setter Property="Opacity" TargetName="TemplateRoot" Value="0.5" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Brush.Foreground.Disabled}" />
                <Setter Property="BorderBrush" TargetName="Border" Value="{StaticResource Brush.Border.Disabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style
        BasedOn="{StaticResource {x:Type ContentControl}}"
        TargetType="ButtonBase"
        x:Key="Style.ButtonBase">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="{StaticResource Brush.Background.Normal}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Normal}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Border.Normal}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="8,7" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template" Value="{StaticResource Template.ButtonBase}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Style.Focus.Outer.Uniform}" />
    </Style>
    <Style BasedOn="{StaticResource Style.ButtonBase}" TargetType="Button" />
    <Style BasedOn="{StaticResource Style.ButtonBase}" TargetType="RepeatButton" />

    <!--  AlpaButton  -->
    <Style
    BasedOn="{StaticResource Style.ButtonBase}"
    TargetType="Button"
    x:Key="AlphaButtonStyle1">
        <Setter Property="Opacity" Value="0.6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="TemplateRoot" Opacity="0.7">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <!-- Normal state -->
                                <VisualState x:Name="Normal"/>
                                <!-- MouseOver state -->
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimation
                                        Storyboard.TargetName="TemplateRoot"
                                        Storyboard.TargetProperty="Opacity"
                                        To="0.75"
                                        Duration="0:0:0.2" />
                                    </Storyboard>
                                </VisualState>
                                <!-- Pressed state -->
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation
                                        Storyboard.TargetName="TemplateRoot"
                                        Storyboard.TargetProperty="Opacity"
                                        To="0.85"
                                        Duration="0:0:0.2" />
                                    </Storyboard>
                                </VisualState>
                                <!-- Disabled state -->
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation
                                        Storyboard.TargetName="TemplateRoot"
                                        Storyboard.TargetProperty="Opacity"
                                        To="0.5"
                                        Duration="0:0:0.2" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                   />
                        <ContentPresenter
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        Margin="{TemplateBinding Padding}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style
    BasedOn="{StaticResource Style.ButtonBase}"
    TargetType="Button"
    x:Key="AlphaButtonStyle">
        <Setter Property="Opacity" Value="1" />
        <Style.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.75" />
            </Trigger>
            <Trigger Property="IsPressed" Value="False">
                <Setter Property="Opacity" Value="0.85" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  ProgressBar  -->
    <ControlTemplate TargetType="ProgressBar" x:Key="Template.ProgressBar">
        <ControlTemplate.Resources>
            <Storyboard x:Key="Anim.Indeterminate">
                <DoubleAnimation
                    Duration="0:0:2"
                    From="-1"
                    RepeatBehavior="Forever"
                    Storyboard.TargetName="IndicatorIndeterminate"
                    Storyboard.TargetProperty="Background.RelativeTransform.X"
                    To="1" />
            </Storyboard>
        </ControlTemplate.Resources>
        <Grid MinHeight="4" x:Name="TemplateRoot">
            <Border
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                x:Name="PART_Track">
                <Grid>
                    <Border
                        Background="{TemplateBinding Foreground}"
                        HorizontalAlignment="Left"
                        x:Name="PART_Indicator" />
                    <Border Visibility="Collapsed" x:Name="IndicatorIndeterminate">
                        <Border.Background>
                            <LinearGradientBrush EndPoint="1,0" StartPoint="0,0">
                                <LinearGradientBrush.RelativeTransform>
                                    <TranslateTransform />
                                </LinearGradientBrush.RelativeTransform>
                                <GradientStop Color="{Binding Background.Color, RelativeSource={RelativeSource TemplatedParent}}" Offset="0" />
                                <GradientStop Color="{Binding Foreground.Color, RelativeSource={RelativeSource TemplatedParent}}" Offset="0.5" />
                                <GradientStop Color="{Binding Background.Color, RelativeSource={RelativeSource TemplatedParent}}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="LayoutTransform" TargetName="TemplateRoot">
                    <Setter.Value>
                        <RotateTransform Angle="-90" />
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="IsIndeterminate" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource Anim.Indeterminate}" />
                </Trigger.EnterActions>
                <Setter Property="Visibility" TargetName="PART_Indicator" Value="Collapsed" />
                <Setter Property="Visibility" TargetName="IndicatorIndeterminate" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
                <Setter Property="Foreground" Value="{StaticResource Brush.Border.DisabledChecked}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style BasedOn="{StaticResource {x:Type Control}}" TargetType="ProgressBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Background.Checked}" />
        <Setter Property="Background" Value="{StaticResource Brush.Background.Normal}" />
        <Setter Property="Template" Value="{StaticResource Template.ProgressBar}" />
    </Style>

    <!--  Slider  -->
    <Style TargetType="Thumb" x:Key="Style.Slider.Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Ellipse
                            Fill="{TemplateBinding Background}"
                            Height="20"
                            Margin="-8"
                            Width="20"
                            x:Name="Thumb" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter Property="Fill" TargetName="Thumb" Value="{StaticResource Brush.Thumb.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Fill" TargetName="Thumb" Value="{StaticResource Brush.Border.DisabledChecked}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style
        BasedOn="{StaticResource {x:Type RepeatButton}}"
        TargetType="RepeatButton"
        x:Key="Style.Slider.RepeatButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Delay" Value="250" />
        <Setter Property="Interval" Value="100" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Corner.Border2}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <ControlTemplate TargetType="Slider" x:Key="Template.Slider.Horizontal">
        <Grid
            Height="20"
            Margin="8,0"
            x:Name="TemplateRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border
                Background="{TemplateBinding Background}"
                CornerRadius="{DynamicResource Corner.Border2}"
                Grid.Row="1"
                Height="2"
                x:Name="Background" />
            <Border Grid.Row="0" Height="8">
                <TickBar
                    Fill="{TemplateBinding Background}"
                    Height="4"
                    Placement="Top"
                    VerticalAlignment="Top"
                    Visibility="Hidden"
                    x:Name="TopTicks" />
            </Border>
            <Border Grid.Row="2" Height="8">
                <TickBar
                    Fill="{TemplateBinding Background}"
                    Height="4"
                    Placement="Bottom"
                    VerticalAlignment="Bottom"
                    Visibility="Hidden"
                    x:Name="BottomTicks" />
            </Border>
            <Track
                Grid.RowSpan="3"
                Orientation="Horizontal"
                x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton
                        Background="{TemplateBinding Foreground}"
                        Command="Slider.DecreaseLarge"
                        Margin="0,0,-1,0"
                        Padding="0,9"
                        Style="{StaticResource Style.Slider.RepeatButton}"
                        x:Name="DecreaseButton" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton
                        Background="Transparent"
                        Command="Slider.IncreaseLarge"
                        Padding="0,9"
                        Style="{StaticResource Style.Slider.RepeatButton}"
                        x:Name="IncreaseButton" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb
                        Background="{TemplateBinding Foreground}"
                        Style="{StaticResource Style.Slider.Thumb}"
                        x:Name="Thumb" />
                </Track.Thumb>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsDirectionReversed" Value="True">
                <Setter Property="Margin" TargetName="DecreaseButton" Value="-2,0,0,0" />
            </Trigger>
            <Trigger Property="local:Element.IsFocusEngaged" Value="True">
                <Setter Property="Background" TargetName="Thumb" Value="{StaticResource Brush.Border.Pressed}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" TargetName="Thumb" Value="{StaticResource Brush.Border.Over}" />
            </Trigger>
            <Trigger Property="TickPlacement" Value="TopLeft">
                <Setter Property="Visibility" TargetName="TopTicks" Value="Visible" />
            </Trigger>
            <Trigger Property="TickPlacement" Value="BottomRight">
                <Setter Property="Visibility" TargetName="BottomTicks" Value="Visible" />
            </Trigger>
            <Trigger Property="TickPlacement" Value="Both">
                <Setter Property="Visibility" TargetName="TopTicks" Value="Visible" />
                <Setter Property="Visibility" TargetName="BottomTicks" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" TargetName="DecreaseButton" Value="{DynamicResource Brush.Border.DisabledChecked}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate TargetType="Slider" x:Key="Template.Slider.Vertical">
        <Grid
            Margin="0,8"
            Width="20"
            x:Name="TemplateRoot">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border
                Background="{TemplateBinding Background}"
                CornerRadius="{DynamicResource Corner.Border2}"
                Grid.Column="1"
                Width="2"
                x:Name="Background" />
            <Border Grid.Column="0" Width="8">
                <TickBar
                    Fill="{TemplateBinding Background}"
                    HorizontalAlignment="Left"
                    Placement="Left"
                    Visibility="Hidden"
                    Width="4"
                    x:Name="LeftTicks" />
            </Border>
            <Border Grid.Column="2" Width="8">
                <TickBar
                    Fill="{TemplateBinding Background}"
                    HorizontalAlignment="Right"
                    Placement="Right"
                    Visibility="Hidden"
                    Width="4"
                    x:Name="RightTicks" />
            </Border>
            <Track
                Grid.ColumnSpan="3"
                Orientation="Vertical"
                x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton
                        Background="{TemplateBinding Foreground}"
                        Command="Slider.DecreaseLarge"
                        Margin="0,-1,0,0"
                        Padding="9,0"
                        Style="{StaticResource Style.Slider.RepeatButton}"
                        x:Name="DecreaseButton" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton
                        Background="Transparent"
                        Command="Slider.IncreaseLarge"
                        Padding="9,0"
                        Style="{StaticResource Style.Slider.RepeatButton}"
                        x:Name="IncreaseButton" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb
                        Background="{TemplateBinding Foreground}"
                        Style="{StaticResource Style.Slider.Thumb}"
                        x:Name="Thumb" />
                </Track.Thumb>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsDirectionReversed" Value="True">
                <Setter Property="Margin" TargetName="DecreaseButton" Value="0,0,0,-2" />
            </Trigger>
            <Trigger Property="local:Element.IsFocusEngaged" Value="True">
                <Setter Property="Background" TargetName="Thumb" Value="{DynamicResource Brush.Border.Pressed}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" TargetName="Thumb" Value="{DynamicResource Brush.Glyph.Over}" />
            </Trigger>
            <Trigger Property="TickPlacement" Value="TopLeft">
                <Setter Property="Visibility" TargetName="LeftTicks" Value="Visible" />
            </Trigger>
            <Trigger Property="TickPlacement" Value="BottomRight">
                <Setter Property="Visibility" TargetName="RightTicks" Value="Visible" />
            </Trigger>
            <Trigger Property="TickPlacement" Value="Both">
                <Setter Property="Visibility" TargetName="LeftTicks" Value="Visible" />
                <Setter Property="Visibility" TargetName="RightTicks" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" TargetName="DecreaseButton" Value="{DynamicResource Brush.Border.DisabledChecked}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style BasedOn="{StaticResource {x:Type Control}}" TargetType="Slider">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Background.Checked}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Normal}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Style.Focus.Outer.Uniform}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Template" Value="{StaticResource Template.Slider.Horizontal}" />
            </Trigger>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Template" Value="{StaticResource Template.Slider.Vertical}" />
            </Trigger>
        </Style.Triggers>
    </Style>



    <!--  ToggleButton  -->
    <Style
        BasedOn="{StaticResource {x:Type ToggleButton}}"
        TargetType="ToggleButton"
        x:Key="Style.Expander.Toggle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <ContentPresenter />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Style.Focus.Outer.Uniform}" />
    </Style>
    <Geometry x:Key="Geometry.Expander.Arrow">M0,0L6,6 0,12</Geometry>
    <ControlTemplate TargetType="Expander" x:Key="Template.Expander">
        <ControlTemplate.Resources>
            <Storyboard x:Key="Anim.Loaded">
                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Tag">
                    <DiscreteObjectKeyFrame KeyTime="0" Value="1" />
                </ObjectAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="Anim.Expand.Vertical.Loaded">
                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentBorder" Storyboard.TargetProperty="Visibility">
                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                </ObjectAnimationUsingKeyFrames>
                <DoubleAnimation
                    Duration="0"
                    Storyboard.TargetName="ContentBg"
                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                    To="1" />
                <DoubleAnimation
                    Duration="0"
                    Storyboard.TargetName="ContentBg"
                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                    To="1" />
            </Storyboard>
            <Storyboard x:Key="Anim.Expand.Vertical.Up.Loaded">
                <DoubleAnimation
                    Duration="0"
                    Storyboard.TargetName="Arrow"
                    Storyboard.TargetProperty="RenderTransform.Angle"
                    To="-90" />
                <StaticResource ResourceKey="Anim.Expand.Vertical.Loaded" />
            </Storyboard>
            <Storyboard x:Key="Anim.Expand.Vertical.Down.Loaded">
                <DoubleAnimation
                    Duration="0"
                    Storyboard.TargetName="Arrow"
                    Storyboard.TargetProperty="RenderTransform.Angle"
                    To="90" />
                <StaticResource ResourceKey="Anim.Expand.Vertical.Loaded" />
            </Storyboard>
            <Storyboard x:Key="Anim.Expand.Horizontal.Loaded">
                <DoubleAnimation
                    Duration="0"
                    Storyboard.TargetName="Arrow"
                    Storyboard.TargetProperty="RenderTransform.Angle"
                    To="90" />
                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentBorder" Storyboard.TargetProperty="Visibility">
                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                </ObjectAnimationUsingKeyFrames>
                <DoubleAnimation
                    Duration="0"
                    Storyboard.TargetName="ContentBg"
                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                    To="1">
                    <DoubleAnimation.EasingFunction>
                        <BackEase Amplitude="0.2" EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Duration="0"
                    Storyboard.TargetName="ContentBg"
                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                    To="1" />
            </Storyboard>
            <Storyboard x:Key="Anim.Expand.Vertical">
                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentBorder" Storyboard.TargetProperty="Visibility">
                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                </ObjectAnimationUsingKeyFrames>
                <DoubleAnimation
                    Duration="0"
                    Storyboard.TargetName="ContentBg"
                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                    To="1" />
                <DoubleAnimation
                    Duration="0:0:0.2"
                    Storyboard.TargetName="ContentBg"
                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                    To="1">
                    <DoubleAnimation.EasingFunction>
                        <BackEase Amplitude="0.2" EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
            <Storyboard x:Key="Anim.Expand.Vertical.Up">
                <DoubleAnimation
                    Duration="0:0:0.15"
                    Storyboard.TargetName="Arrow"
                    Storyboard.TargetProperty="RenderTransform.Angle"
                    To="-90" />
                <StaticResource ResourceKey="Anim.Expand.Vertical" />
            </Storyboard>
            <Storyboard x:Key="Anim.Expand.Vertical.Down">
                <DoubleAnimation
                    Duration="0:0:0.15"
                    Storyboard.TargetName="Arrow"
                    Storyboard.TargetProperty="RenderTransform.Angle"
                    To="90" />
                <StaticResource ResourceKey="Anim.Expand.Vertical" />
            </Storyboard>
            <Storyboard x:Key="Anim.Collapse.Vertical">
                <DoubleAnimation
                    Duration="0:0:0.2"
                    Storyboard.TargetName="Arrow"
                    Storyboard.TargetProperty="RenderTransform.Angle"
                    To="0" />
                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentBorder" Storyboard.TargetProperty="Visibility">
                    <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Collapsed}" />
                </ObjectAnimationUsingKeyFrames>
                <DoubleAnimation
                    AccelerationRatio="0.5"
                    Duration="0:0:0.2"
                    Storyboard.TargetName="ContentBg"
                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                    To="0" />
            </Storyboard>
            <Storyboard x:Key="Anim.Expand.Horizontal">
                <DoubleAnimation
                    Duration="0:0:0.15"
                    Storyboard.TargetName="Arrow"
                    Storyboard.TargetProperty="RenderTransform.Angle"
                    To="90" />
                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentBorder" Storyboard.TargetProperty="Visibility">
                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                </ObjectAnimationUsingKeyFrames>
                <DoubleAnimation
                    Duration="0:0:0.2"
                    Storyboard.TargetName="ContentBg"
                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                    To="1">
                    <DoubleAnimation.EasingFunction>
                        <BackEase Amplitude="0.2" EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Duration="0"
                    Storyboard.TargetName="ContentBg"
                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                    To="1" />
            </Storyboard>
            <Storyboard x:Key="Anim.Collapse.Horizontal">
                <DoubleAnimation
                    Duration="0:0:0.2"
                    Storyboard.TargetName="Arrow"
                    Storyboard.TargetProperty="RenderTransform.Angle"
                    To="0" />
                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentBorder" Storyboard.TargetProperty="Visibility">
                    <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Collapsed}" />
                </ObjectAnimationUsingKeyFrames>
                <DoubleAnimation
                    AccelerationRatio="0.5"
                    Duration="0:0:0.2"
                    Storyboard.TargetName="ContentBg"
                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                    To="0" />
            </Storyboard>
        </ControlTemplate.Resources>
        <Grid Tag="0" x:Name="Root">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ToggleButton
                Foreground="{TemplateBinding Foreground}"
                IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                Style="{StaticResource Style.Expander.Toggle}"
                x:Name="ExpanderButton">
                <Border
                    Background="{DynamicResource Brush.Header.Normal}"
                    CornerRadius="{DynamicResource Corner.Border0.Top}"
                    x:Name="HeaderBg">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path
                            Data="{StaticResource Geometry.Expander.Arrow}"
                            Grid.Column="0"
                            Margin="14,11.5"
                            RenderTransformOrigin="0.5,0.5"
                            Stroke="{StaticResource Brush.Element.Dark}"
                            x:Name="Arrow">
                            <Path.RenderTransform>
                                <RotateTransform />
                            </Path.RenderTransform>
                        </Path>
                        <ContentPresenter
                            ContentSource="Header"
                            Grid.Column="1"
                            Margin="0,0,14,0"
                            TextElement.FontSize="{DynamicResource Font.Size.Header}"
                            VerticalAlignment="Center"
                            x:Name="HeaderHost" />
                    </Grid>
                </Border>
            </ToggleButton>
            <Decorator
                Grid.Column="1"
                Grid.Row="1"
                Visibility="Collapsed"
                x:Name="ContentBorder">
                <Border
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{DynamicResource Corner.Border0.Bottom}"
                    Padding="{TemplateBinding Padding}"
                    x:Name="ContentBg">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="0" ScaleY="0" />
                    </Border.RenderTransform>
                    <ContentPresenter
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        x:Name="ContentHost" />
                </Border>
            </Decorator>
        </Grid>
        <ControlTemplate.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded" SourceName="Root">
                <BeginStoryboard Storyboard="{StaticResource Anim.Loaded}" />
            </EventTrigger>
            <Trigger Property="IsMouseOver" SourceName="ExpanderButton" Value="True">
                <Setter Property="Background" TargetName="HeaderBg" Value="{DynamicResource Brush.Header.Over}" />
                <Setter Property="Stroke" TargetName="Arrow" Value="{DynamicResource Brush.Glyph.Over}" />
            </Trigger>
            <Trigger Property="IsPressed" SourceName="ExpanderButton" Value="True">
                <Setter Property="Background" TargetName="HeaderBg" Value="{DynamicResource Brush.Header.Pressed}" />
            </Trigger>
            <Trigger Property="IsExpanded" Value="True">
                <Setter Property="Background" TargetName="HeaderBg" Value="{DynamicResource Brush.Header.Checked}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsExpanded" Value="True" />
                    <Condition Property="IsMouseOver" SourceName="ExpanderButton" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" TargetName="HeaderBg" Value="{DynamicResource Brush.Header.CheckedOver}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsExpanded" Value="True" />
                    <Condition Property="IsPressed" SourceName="ExpanderButton" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" TargetName="HeaderBg" Value="{DynamicResource Brush.Header.CheckedPressed}" />
            </MultiTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Tag, ElementName=Root}" Value="0" />
                    <Condition Binding="{Binding IsExpanded, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding ExpandDirection, RelativeSource={RelativeSource Self}}" Value="Up" />
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource Anim.Expand.Vertical.Up.Loaded}" />
                </MultiDataTrigger.EnterActions>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Tag, ElementName=Root}" Value="0" />
                    <Condition Binding="{Binding IsExpanded, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding ExpandDirection, RelativeSource={RelativeSource Self}}" Value="Down" />
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource Anim.Expand.Vertical.Down.Loaded}" />
                </MultiDataTrigger.EnterActions>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Tag, ElementName=Root}" Value="0" />
                    <Condition Binding="{Binding IsExpanded, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding ExpandDirection, RelativeSource={RelativeSource Self}}" Value="Left" />
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource Anim.Expand.Horizontal.Loaded}" />
                </MultiDataTrigger.EnterActions>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Tag, ElementName=Root}" Value="0" />
                    <Condition Binding="{Binding IsExpanded, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding ExpandDirection, RelativeSource={RelativeSource Self}}" Value="Right" />
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource Anim.Expand.Horizontal.Loaded}" />
                </MultiDataTrigger.EnterActions>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Tag, ElementName=Root}" Value="1" />
                    <Condition Binding="{Binding IsExpanded, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding ExpandDirection, RelativeSource={RelativeSource Self}}" Value="Up" />
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource Anim.Expand.Vertical.Up}" />
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource Anim.Collapse.Vertical}" />
                </MultiDataTrigger.ExitActions>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Tag, ElementName=Root}" Value="1" />
                    <Condition Binding="{Binding IsExpanded, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding ExpandDirection, RelativeSource={RelativeSource Self}}" Value="Down" />
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource Anim.Expand.Vertical.Down}" />
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource Anim.Collapse.Vertical}" />
                </MultiDataTrigger.ExitActions>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Tag, ElementName=Root}" Value="1" />
                    <Condition Binding="{Binding IsExpanded, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding ExpandDirection, RelativeSource={RelativeSource Self}}" Value="Left" />
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource Anim.Expand.Horizontal}" />
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource Anim.Collapse.Horizontal}" />
                </MultiDataTrigger.ExitActions>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Tag, ElementName=Root}" Value="1" />
                    <Condition Binding="{Binding IsExpanded, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding ExpandDirection, RelativeSource={RelativeSource Self}}" Value="Right" />
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource Anim.Expand.Horizontal}" />
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource Anim.Collapse.Horizontal}" />
                </MultiDataTrigger.ExitActions>
            </MultiDataTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Disabled}" />
                <Setter Property="Stroke" TargetName="Arrow" Value="{DynamicResource Brush.Glyph.Disabled}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="False" />
                    <Condition Property="IsExpanded" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.DisabledChecked}" />
                <Setter Property="Stroke" TargetName="Arrow" Value="{DynamicResource Brush.Foreground.DisabledChecked}" />
            </MultiTrigger>
            <Trigger Property="ExpandDirection" Value="Down">
                <Setter Property="Grid.Row" TargetName="ExpanderButton" Value="0" />
                <Setter Property="Grid.Column" TargetName="ExpanderButton" Value="1" />
                <Setter Property="RenderTransformOrigin" TargetName="ContentBg" Value="0.5,0" />
            </Trigger>
            <Trigger Property="ExpandDirection" Value="Up">
                <Setter Property="Grid.Row" TargetName="ExpanderButton" Value="2" />
                <Setter Property="Grid.Column" TargetName="ExpanderButton" Value="1" />
                <Setter Property="RenderTransformOrigin" TargetName="ContentBg" Value="0.5,1" />
            </Trigger>
            <Trigger Property="ExpandDirection" Value="Right">
                <Setter Property="Grid.Row" TargetName="ExpanderButton" Value="1" />
                <Setter Property="Grid.Column" TargetName="ExpanderButton" Value="0" />
                <Setter Property="RenderTransformOrigin" TargetName="ContentBg" Value="0,0.5" />
                <Setter Property="LayoutTransform" TargetName="ExpanderButton">
                    <Setter.Value>
                        <RotateTransform Angle="-90" />
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="ExpandDirection" Value="Left">
                <Setter Property="Grid.Row" TargetName="ExpanderButton" Value="1" />
                <Setter Property="Grid.Column" TargetName="ExpanderButton" Value="2" />
                <Setter Property="RenderTransformOrigin" TargetName="ContentBg" Value="1,0.5" />
                <Setter Property="LayoutTransform" TargetName="ExpanderButton">
                    <Setter.Value>
                        <RotateTransform Angle="90" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style BasedOn="{StaticResource {x:Type HeaderedContentControl}}" TargetType="Expander">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="{DynamicResource Brush.Header.Normal}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Template" Value="{StaticResource Template.Expander}" />
    </Style>



    <!--  TextBox  -->
    <Style TargetType="TextBlock" x:Key="Style.TextBox.Placeholder">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Placeholder}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.DisabledPlaceholder}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <ControlTemplate TargetType="TextBox" x:Key="Template.TextBox">
        <Grid>
            <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Corner.Border0}" />
            <Grid>
                <Border
                    Margin="2,0"
                    Padding="{TemplateBinding Padding}"
                    Visibility="Collapsed"
                    x:Name="Placeholder">
                    <TextBlock Style="{DynamicResource Style.TextBox.Placeholder}" Text="{Binding (local:Text.Placeholder), RelativeSource={RelativeSource TemplatedParent}}" />
                </Border>
                <ScrollViewer
                    Focusable="False"
                    Foreground="{TemplateBinding Foreground}"
                    Padding="{TemplateBinding Padding}"
                    x:Name="PART_ContentHost" />
            </Grid>
            <Border
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{DynamicResource Corner.Border1}"
                x:Name="Border" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" TargetName="Placeholder" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Over}" />
                <Setter Property="BorderThickness" TargetName="Border" Value="{DynamicResource Border.Over}" />
                <Setter Property="CornerRadius" TargetName="Border" Value="{DynamicResource Corner.Border2}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.TextBox.Focused}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Checked}" />
                <Setter Property="BorderThickness" TargetName="Border" Value="{DynamicResource Border.Focus}" />
                <Setter Property="CornerRadius" TargetName="Border" Value="{DynamicResource Corner.Border2}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Disabled}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Disabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style BasedOn="{StaticResource {x:Type Control}}" TargetType="TextBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="{DynamicResource Brush.TextBox.Normal}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Normal}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Border.Box}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Foreground.Normal}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Background.Checked}" />
        <Setter Property="SelectionOpacity" Value="0.25" />
        <Setter Property="Padding" Value="6,7" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="Template" Value="{StaticResource Template.TextBox}" />
        <Setter Property="ContextMenu">
            <Setter.Value>
                <ContextMenu>
                    <MenuItem Command="ApplicationCommands.Cut" />
                    <MenuItem Command="ApplicationCommands.Copy" />
                    <MenuItem Command="ApplicationCommands.Paste" />
                </ContextMenu>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="True">
                <Setter Property="Cursor" Value="IBeam" />
            </Trigger>
        </Style.Triggers>
    </Style>





</ResourceDictionary>