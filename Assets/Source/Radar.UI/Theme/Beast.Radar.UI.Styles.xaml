<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:local="clr-namespace:NoesisGUIExtensions"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Beast.Radar.UI.Brushes.xaml" />

    </ResourceDictionary.MergedDictionaries>

    <sys:Double x:Key="Size.ScrollBar">17</sys:Double>
    <sys:Double x:Key="Size.GroupBox.Border">1</sys:Double>
    <sys:Double x:Key="Size.Button.Border">1</sys:Double>



    <sys:Double x:Key="Size.Screen.Wight">1260</sys:Double>
    <sys:Double x:Key="Size.Screen.Height">780</sys:Double>


    <Thickness x:Key="Border.Normal">1</Thickness>
    <Thickness x:Key="Border.Box">1</Thickness>
    <Thickness x:Key="Border.Over">2</Thickness>
    <Thickness x:Key="Border.Focus">2</Thickness>

    <Thickness x:Key="Margin.Focus.Uniform">-3</Thickness>
    <Thickness x:Key="Margin.Focus.Padded">-8,-3</Thickness>

    <Thickness x:Key="Margin.SafeArea.Left">15 0 0 0</Thickness>
    <Thickness x:Key="Margin.SafeArea.Right">0 0 15 0</Thickness>
    <Thickness x:Key="Margin.Left">10 0 0 0</Thickness>
    <Thickness x:Key="Margin.Top">0 10 0 0</Thickness>
    <Thickness x:Key="Margin.LeftTop">10 10 0 0</Thickness>
    <Thickness x:Key="Margin.TopLeft">10 10 0 0</Thickness>
    <Thickness x:Key="Margin.Right">0 0 10 0</Thickness>
    <Thickness x:Key="Margin.Bottom">0 0 0 10</Thickness>
    <Thickness x:Key="Margin.RightBottom">0 0 10 10</Thickness>
    <Thickness x:Key="Margin.BottomRight">0 0 10 10</Thickness>
    <Thickness x:Key="Margin.LeftRightBottom">10 0 10 10</Thickness>
    <Thickness x:Key="Margin.LeftBottom">10 0 0 10</Thickness>
    <Thickness x:Key="Margin.LeftBottomTop">10 10 0 10</Thickness>
    <Thickness x:Key="Margin.LeftBottomTopBottom">10 10 10 10</Thickness>
    <Thickness x:Key="Margin.GridElement">15</Thickness>

    <CornerRadius x:Key="Corner.Border0">0</CornerRadius>
    <CornerRadius x:Key="Corner.Border0.Top">1.75,1.75,0,0</CornerRadius>
    <CornerRadius x:Key="Corner.Border0.Bottom">0,0,1.75,1.75</CornerRadius>
    <CornerRadius x:Key="Corner.Border0.Left">1.75,0,0,1.75</CornerRadius>
    <CornerRadius x:Key="Corner.Border0.Right">0,1.75,1.75,0</CornerRadius>
    <CornerRadius x:Key="Corner.Border1">1.25</CornerRadius>
    <CornerRadius x:Key="Corner.Border1.Top">1.25,1.25,0,0</CornerRadius>
    <CornerRadius x:Key="Corner.Border1.Bottom">0,0,1.25,1.25</CornerRadius>
    <CornerRadius x:Key="Corner.Border1.Left">1.25,0,0,1.25</CornerRadius>
    <CornerRadius x:Key="Corner.Border1.Right">0,1.25,1.25,0</CornerRadius>
    <CornerRadius x:Key="Corner.Border2">0.75</CornerRadius>
    <CornerRadius x:Key="Corner.Border2.Top">0.75,0.75,0,0</CornerRadius>
    <CornerRadius x:Key="Corner.Border2.Bottom">0,0,0.75,0.75</CornerRadius>
    <CornerRadius x:Key="Corner.Border2.Left">0.75,0,0,0.75</CornerRadius>
    <CornerRadius x:Key="Corner.Border2.Right">0,0.75,0.75,0</CornerRadius>
    <CornerRadius x:Key="Corner.Focus">0</CornerRadius>
    <CornerRadius x:Key="Corner.Popup">3</CornerRadius>


    <!--  ============== BASE ==============  -->

    <!--  Focus Styles  -->
    <Style TargetType="Control" x:Key="Style.Focus.Outer.Uniform">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Border
                        BorderBrush="{DynamicResource Brush.Border.Focus}"
                        BorderThickness="{DynamicResource Border.Focus}"
                        CornerRadius="{DynamicResource Corner.Focus}"
                        Margin="{DynamicResource Margin.Focus.Uniform}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Control" x:Key="Style.Focus.Outer.Padded">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Border
                        BorderBrush="{DynamicResource Brush.Border.Focus}"
                        BorderThickness="{DynamicResource Border.Focus}"
                        CornerRadius="{DynamicResource Corner.Focus}"
                        Margin="{DynamicResource Margin.Focus.Padded}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Control" x:Key="Style.Focus.Inner.Uniform">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Border
                        BorderBrush="{DynamicResource Brush.Border.Focus}"
                        BorderThickness="{DynamicResource Border.Focus}"
                        CornerRadius="{DynamicResource Corner.Focus}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Base Control Styles  -->
    <Style x:Key="Style.Base">
        <Setter Property="Control.Foreground" Value="{DynamicResource Brush.Foreground.Normal}" />
        <Setter Property="Control.HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Control.VerticalContentAlignment" Value="Stretch" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    </Style>
    <Style BasedOn="{StaticResource Style.Base}" TargetType="Control" />
    <Style BasedOn="{StaticResource Style.Base}" TargetType="ContentControl" />
    <Style BasedOn="{StaticResource Style.Base}" TargetType="HeaderedContentControl" />
    <Style BasedOn="{StaticResource Style.Base}" TargetType="ItemsControl">
        <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Style.Focus.Outer.Uniform}" />
    </Style>
    <Style BasedOn="{StaticResource Style.Base}" TargetType="HeaderedItemsControl">
        <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst" />
    </Style>
    <Style BasedOn="{StaticResource Style.Base}" TargetType="UserControl" />
    <Style BasedOn="{StaticResource Style.Base}" TargetType="Page" />
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Normal}" />
    </Style>



    <!--  ============== TEXT ==============  -->

    <!--  TextBox  -->
    <Style TargetType="TextBlock" x:Key="Style.Text.Light.Normal">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Normal}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Light.Normal}" />
    </Style>
    <Style TargetType="TextBlock" x:Key="Style.Text.Light.Header">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Header}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Light.Normal}" />
    </Style>
    <Style TargetType="TextBlock" x:Key="Style.Text.Dark.Header">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Header}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Dark.Normal}" />
    </Style>
    <Style TargetType="TextBlock" x:Key="Style.TextBox.Placeholder">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Placeholder}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.DisabledPlaceholder}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <ControlTemplate TargetType="TextBox" x:Key="Template.TextBox">
        <Grid>
            <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Corner.Border0}" />
            <Grid>
                <Border
                    Margin="2,0"
                    Padding="{TemplateBinding Padding}"
                    Visibility="Collapsed"
                    x:Name="Placeholder">
                    <TextBlock Style="{DynamicResource Style.TextBox.Placeholder}" />
                </Border>
                <ScrollViewer
                    Focusable="False"
                    Foreground="{TemplateBinding Foreground}"
                    Padding="{TemplateBinding Padding}"
                    x:Name="PART_ContentHost" />
            </Grid>
            <Border
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{DynamicResource Corner.Border1}"
                x:Name="Border" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" TargetName="Placeholder" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Over}" />
                <Setter Property="BorderThickness" TargetName="Border" Value="{DynamicResource Border.Over}" />
                <Setter Property="CornerRadius" TargetName="Border" Value="{DynamicResource Corner.Border2}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.TextBox.Focused}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Checked}" />
                <Setter Property="BorderThickness" TargetName="Border" Value="{DynamicResource Border.Focus}" />
                <Setter Property="CornerRadius" TargetName="Border" Value="{DynamicResource Corner.Border2}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Disabled}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Disabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style BasedOn="{StaticResource {x:Type Control}}" TargetType="TextBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="{DynamicResource Brush.TextBox.Normal}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Normal}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Border.Box}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Foreground.Normal}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Background.Checked}" />
        <Setter Property="SelectionOpacity" Value="0.25" />
        <Setter Property="Padding" Value="6,7" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="Template" Value="{StaticResource Template.TextBox}" />
        <Setter Property="ContextMenu">
            <Setter.Value>
                <ContextMenu>
                    <MenuItem Command="ApplicationCommands.Cut" />
                    <MenuItem Command="ApplicationCommands.Copy" />
                    <MenuItem Command="ApplicationCommands.Paste" />
                </ContextMenu>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="True">
                <Setter Property="Cursor" Value="IBeam" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  ============== BUTTONS ==============  -->

    <!--  Button/RepeatButton  -->
    <ControlTemplate TargetType="ButtonBase" x:Key="Template.ButtonBase">
        <Grid RenderTransformOrigin="0.5,0.5" x:Name="TemplateRoot">
            <Grid.RenderTransform>
                <ScaleTransform />
            </Grid.RenderTransform>
            <Border
                Background="{TemplateBinding Background}"
                CornerRadius="{DynamicResource Corner.Border0}"
                x:Name="Border" />
            <ContentPresenter
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                Margin="{TemplateBinding Padding}"
                TextElement.Foreground="{TemplateBinding Foreground}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                x:Name="PART_ContentPresenter" />
            <Rectangle
                Fill="{TemplateBinding BorderBrush}"
                Height="3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                x:Name="BottomStripe" />
        </Grid>
        <ControlTemplate.Resources>
            <Storyboard x:Key="Anim.Press">
                <DoubleAnimation
                    DecelerationRatio="0.25"
                    Duration="0:0:0.1"
                    Storyboard.TargetName="TemplateRoot"
                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                    To="0.99" />
                <DoubleAnimation
                    DecelerationRatio="0.25"
                    Duration="0:0:0.1"
                    Storyboard.TargetName="TemplateRoot"
                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                    To="0.99" />
            </Storyboard>
            <Storyboard x:Key="Anim.Release">
                <DoubleAnimation
                    DecelerationRatio="1"
                    Duration="0:0:0.2"
                    Storyboard.TargetName="TemplateRoot"
                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                    To="1" />
                <DoubleAnimation
                    DecelerationRatio="1"
                    Duration="0:0:0.2"
                    Storyboard.TargetName="TemplateRoot"
                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                    To="1" />
            </Storyboard>
        </ControlTemplate.Resources>
        <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource Anim.Press}" />
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource Anim.Release}" />
                </Trigger.ExitActions>
                <Setter Property="Background" TargetName="Border" Value="{DynamicResource Brush.Button.Normal}" />
                <Setter Property="CornerRadius" TargetName="Border" Value="{DynamicResource Corner.Border0}" />
                <Setter Property="Fill" TargetName="BottomStripe" Value="{DynamicResource Brush.Accent.Pressed}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Disabled}" />
                <Setter Property="Fill" TargetName="BottomStripe" Value="{DynamicResource Brush.Element.Light.Disabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style
        BasedOn="{StaticResource {x:Type ContentControl}}"
        TargetType="ButtonBase"
        x:Key="Style.ButtonBase">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="{DynamicResource Brush.Button.Normal}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0,0" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template" Value="{StaticResource Template.ButtonBase}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Style.Focus.Outer.Uniform}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Light.Normal}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Header}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Normal}" />
    </Style>

    <!--  Triangle Button  -->
    <ControlTemplate TargetType="ButtonBase" x:Key="Template.TriangleButton">
        <Grid
            Background="Transparent"
            RenderTransformOrigin="0.5,0.5"
            x:Name="TemplateRoot">
            <Grid.RenderTransform>
                <ScaleTransform />
            </Grid.RenderTransform>
            <Border
                Background="Transparent"
                Height="{Binding ActualHeight, RelativeSource={RelativeSource TemplatedParent}}"
                Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" />
            <Path
                Data="M 0,20 L 20,0 L 40,20 Z"
                Fill="{TemplateBinding Background}"
                HorizontalAlignment="Center"
                RenderTransformOrigin="0.5,0.5"
                Stretch="Uniform"
                Stroke="{TemplateBinding BorderBrush}"
                StrokeThickness="{StaticResource Size.Button.Border}"
                VerticalAlignment="Center"
                x:Name="TrianglePath">
                <Path.RenderTransform>
                    <TransformGroup>
                        <RotateTransform Angle="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ScaleTransform x:Name="TriangleScaleTransform" />
                    </TransformGroup>
                </Path.RenderTransform>
            </Path>
            <ContentPresenter
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                Margin="{TemplateBinding Padding}"
                TextElement.Foreground="{TemplateBinding Foreground}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                x:Name="PART_ContentPresenter" />
        </Grid>
        <ControlTemplate.Resources>
            <Storyboard x:Key="Anim.Press">
                <DoubleAnimation
                    DecelerationRatio="0.25"
                    Duration="0:0:0.1"
                    Storyboard.TargetName="TriangleScaleTransform"
                    Storyboard.TargetProperty="ScaleX"
                    To="0.95" />
                <DoubleAnimation
                    DecelerationRatio="0.25"
                    Duration="0:0:0.1"
                    Storyboard.TargetName="TriangleScaleTransform"
                    Storyboard.TargetProperty="ScaleY"
                    To="0.95" />
            </Storyboard>
            <Storyboard x:Key="Anim.Release">
                <DoubleAnimation
                    DecelerationRatio="1"
                    Duration="0:0:0.2"
                    Storyboard.TargetName="TriangleScaleTransform"
                    Storyboard.TargetProperty="ScaleX"
                    To="1" />
                <DoubleAnimation
                    DecelerationRatio="1"
                    Duration="0:0:0.2"
                    Storyboard.TargetName="TriangleScaleTransform"
                    Storyboard.TargetProperty="ScaleY"
                    To="1" />
            </Storyboard>
        </ControlTemplate.Resources>
        <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource Anim.Press}" />
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource Anim.Release}" />
                </Trigger.ExitActions>
                <Setter Property="Fill" TargetName="TrianglePath" Value="{DynamicResource Brush.Accent.Pressed}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Pressed}" />
                <Setter Property="Background" Value="{DynamicResource Brush.Accent.Pressed}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Pressed}" />
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Disabled}" />
                <Setter Property="Fill" TargetName="TrianglePath" Value="{DynamicResource Brush.Element.Light.Disabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style
        BasedOn="{StaticResource {x:Type ContentControl}}"
        TargetType="ButtonBase"
        x:Key="Style.Button.Triangle">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Normal}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="40" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template" Value="{StaticResource Template.TriangleButton}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Style.Focus.Outer.Uniform}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Light.Normal}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Header}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Normal}" />
    </Style>

    <!--  Background button  -->
    <ControlTemplate TargetType="Button" x:Key="Template.Button.Background">
        <Grid RenderTransformOrigin="0.5,0.5" x:Name="TemplateRoot">
            <Border
                Background="{StaticResource Brush.Panel.Background}"
                Opacity="{TemplateBinding Opacity}"
                x:Name="Border" />
        </Grid>
    </ControlTemplate>

    <!--  ToggleButton  -->
    <ControlTemplate TargetType="ToggleButton" x:Key="Template.ToggleButton">
        <Grid RenderTransformOrigin="0.5,0.5" x:Name="TemplateRoot">
            <Grid.RenderTransform>
                <ScaleTransform />
            </Grid.RenderTransform>
            <Border
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{DynamicResource Corner.Border0}"
                x:Name="Border" />
            <ContentPresenter
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                Margin="{TemplateBinding Padding}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                x:Name="PART_ContentPresenter" />
        </Grid>
        <ControlTemplate.Resources>
            <Storyboard x:Key="Anim.Press">
                <DoubleAnimation
                    DecelerationRatio="0.25"
                    Duration="0:0:0.1"
                    Storyboard.TargetName="TemplateRoot"
                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                    To="0.99" />
                <DoubleAnimation
                    DecelerationRatio="0.25"
                    Duration="0:0:0.1"
                    Storyboard.TargetName="TemplateRoot"
                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                    To="0.99" />
            </Storyboard>
            <Storyboard x:Key="Anim.Release">
                <DoubleAnimation
                    DecelerationRatio="1"
                    Duration="0:0:0.2"
                    Storyboard.TargetName="TemplateRoot"
                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                    To="1" />
                <DoubleAnimation
                    DecelerationRatio="1"
                    Duration="0:0:0.2"
                    Storyboard.TargetName="TemplateRoot"
                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                    To="1" />
            </Storyboard>
        </ControlTemplate.Resources>
        <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource Anim.Press}" />
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource Anim.Release}" />
                </Trigger.ExitActions>
                <Setter Property="Background" TargetName="Border" Value="{DynamicResource Brush.Accent.Pressed}" />
                <Setter Property="BorderBrush" TargetName="Border" Value="{DynamicResource Brush.Border.Pressed}" />
                <Setter Property="BorderThickness" TargetName="Border" Value="{DynamicResource Border.Normal}" />
                <Setter Property="CornerRadius" TargetName="Border" Value="{DynamicResource Corner.Border0}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" TargetName="Border" Value="{DynamicResource Brush.Accent.Normal}" />
                <Setter Property="BorderBrush" TargetName="Border" Value="{DynamicResource Brush.Border.Checked}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Disabled}" />
                <Setter Property="BorderBrush" TargetName="Border" Value="{DynamicResource Brush.Border.Disabled}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="False" />
                    <Condition Property="IsChecked" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.DisabledChecked}" />
                <Setter Property="BorderBrush" TargetName="Border" Value="{DynamicResource Brush.Border.DisabledChecked}" />
            </MultiTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style BasedOn="{StaticResource {x:Type ContentControl}}" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="{DynamicResource Brush.Element.Dark.Disabled}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Normal}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Border.Normal}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="8,7" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template" Value="{StaticResource Template.ToggleButton}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Style.Focus.Outer.Uniform}" />
    </Style>


    <!--  Close button  -->

    <ControlTemplate TargetType="Button" x:Key="Template.Button.Close">
        <Grid RenderTransformOrigin="0.5,0.5" x:Name="TemplateRoot">
            <Grid.RenderTransform>
                <ScaleTransform />
            </Grid.RenderTransform>
            <Border
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{StaticResource Border.Normal}"
                CornerRadius="{StaticResource Corner.Border0}"
                x:Name="Border" />
            <Grid
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                x:Name="CrossGrid">
                <Path
                    Data="M 0,0 L 1,1 M 1,0 L 0,1"
                    Height="20"
                    Stretch="Uniform"
                    Stroke="{TemplateBinding Foreground}"
                    StrokeThickness="3"
                    Width="20" />
            </Grid>

        </Grid>

        <ControlTemplate.Resources>
            <Storyboard x:Key="Anim.Press">
                <DoubleAnimation
                    DecelerationRatio="0.25"
                    Duration="0:0:0.1"
                    Storyboard.TargetName="TemplateRoot"
                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                    To="0.9" />
                <DoubleAnimation
                    DecelerationRatio="0.25"
                    Duration="0:0:0.1"
                    Storyboard.TargetName="TemplateRoot"
                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                    To="0.9" />
            </Storyboard>

            <Storyboard x:Key="Anim.Release">
                <DoubleAnimation
                    DecelerationRatio="1"
                    Duration="0:0:0.2"
                    Storyboard.TargetName="TemplateRoot"
                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                    To="1" />
                <DoubleAnimation
                    DecelerationRatio="1"
                    Duration="0:0:0.2"
                    Storyboard.TargetName="TemplateRoot"
                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                    To="1" />
            </Storyboard>
        </ControlTemplate.Resources>

        <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource Anim.Press}" />
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource Anim.Release}" />
                </Trigger.ExitActions>
                <Setter Property="Background" TargetName="Border" Value="{DynamicResource Brush.Button.Normal}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Disabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="Button" x:Key="Style.Button.Close">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="{DynamicResource Brush.Button.Normal}" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Normal}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Style.Focus.Outer.Uniform}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Light.Normal}" />
        <Setter Property="Template" Value="{StaticResource Template.Button.Close}" />
    </Style>


    <!--  ============== RADIO BUTTON ==============  -->


    <ControlTemplate TargetType="RadioButton" x:Key="Template.RadioButtonBase">
        <Grid RenderTransformOrigin="0.5,0.5" x:Name="TemplateRoot">
            <Grid.RenderTransform>
                <ScaleTransform />
            </Grid.RenderTransform>

            <Border
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Corner.Border0}"
                x:Name="Border" />

            <ContentPresenter
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                Margin="{TemplateBinding Padding}"
                TextElement.Foreground="{TemplateBinding Foreground}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                x:Name="PART_ContentPresenter" />

            <!--  Bottom Stripe  -->
            <Rectangle
                Fill="{TemplateBinding BorderBrush}"
                Height="3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                x:Name="BottomStripe" />
        </Grid>

        <ControlTemplate.Resources>
            <!--  Animation for button press  -->
            <Storyboard x:Key="Anim.Press">
                <DoubleAnimation
                    DecelerationRatio="0.25"
                    Duration="0:0:0.1"
                    Storyboard.TargetName="TemplateRoot"
                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                    To="0.99" />
                <DoubleAnimation
                    DecelerationRatio="0.25"
                    Duration="0:0:0.1"
                    Storyboard.TargetName="TemplateRoot"
                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                    To="0.99" />
            </Storyboard>

            <Storyboard x:Key="Anim.Release">
                <DoubleAnimation
                    DecelerationRatio="1"
                    Duration="0:0:0.2"
                    Storyboard.TargetName="TemplateRoot"
                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                    To="1" />
                <DoubleAnimation
                    DecelerationRatio="1"
                    Duration="0:0:0.2"
                    Storyboard.TargetName="TemplateRoot"
                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                    To="1" />
            </Storyboard>
        </ControlTemplate.Resources>

        <ControlTemplate.Triggers>
            <!--  When button is pressed  -->
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource Anim.Press}" />
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource Anim.Release}" />
                </Trigger.ExitActions>
                <Setter Property="Background" TargetName="Border" Value="{DynamicResource Brush.Button.Normal}" />
                <Setter Property="CornerRadius" TargetName="Border" Value="{DynamicResource Corner.Border0}" />
                <Setter Property="Fill" TargetName="BottomStripe" Value="{DynamicResource Brush.Accent.Pressed}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Pressed}" />
            </Trigger>

            <!--  When radio button is selected (IsChecked)  -->
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" TargetName="Border" Value="{DynamicResource Brush.Accent.Normal}" />
                <Setter Property="Fill" TargetName="BottomStripe" Value="{DynamicResource Brush.Accent.Pressed}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Dark.Normal}" />
            </Trigger>

            <!--  When radio button is disabled  -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Disabled}" />
                <Setter Property="Fill" TargetName="BottomStripe" Value="{DynamicResource Brush.Element.Light.Disabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="RadioButton" x:Key="Style.RadioButton.Base">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="{DynamicResource Brush.Button.Normal}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0,0" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template" Value="{StaticResource Template.RadioButtonBase}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Style.Focus.Outer.Uniform}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Light.Normal}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Header}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Normal}" />
    </Style>


    <!--  ============== BAR ==============  -->

    <!--  ProgressBar  -->
    <ControlTemplate TargetType="ProgressBar" x:Key="Template.ProgressBar">
        <ControlTemplate.Resources>
            <Storyboard x:Key="Anim.Indeterminate">
                <DoubleAnimation
                    Duration="0:0:2"
                    From="-1"
                    RepeatBehavior="Forever"
                    Storyboard.TargetName="IndicatorIndeterminate"
                    Storyboard.TargetProperty="Background.RelativeTransform.X"
                    To="1" />
            </Storyboard>
        </ControlTemplate.Resources>
        <Grid MinHeight="4" x:Name="TemplateRoot">
            <Border
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                x:Name="PART_Track">
                <Grid>
                    <Border
                        Background="{TemplateBinding Foreground}"
                        HorizontalAlignment="Left"
                        x:Name="PART_Indicator" />
                    <Border Visibility="Collapsed" x:Name="IndicatorIndeterminate">
                        <Border.Background>
                            <LinearGradientBrush EndPoint="1,0" StartPoint="0,0">
                                <LinearGradientBrush.RelativeTransform>
                                    <TranslateTransform />
                                </LinearGradientBrush.RelativeTransform>
                                <GradientStop Color="{Binding Background.Color, RelativeSource={RelativeSource TemplatedParent}}" Offset="0" />
                                <GradientStop Color="{Binding Foreground.Color, RelativeSource={RelativeSource TemplatedParent}}" Offset="0.5" />
                                <GradientStop Color="{Binding Background.Color, RelativeSource={RelativeSource TemplatedParent}}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="LayoutTransform" TargetName="TemplateRoot">
                    <Setter.Value>
                        <RotateTransform Angle="-90" />
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="IsIndeterminate" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource Anim.Indeterminate}" />
                </Trigger.EnterActions>
                <Setter Property="Visibility" TargetName="PART_Indicator" Value="Collapsed" />
                <Setter Property="Visibility" TargetName="IndicatorIndeterminate" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
                <Setter Property="Foreground" Value="{StaticResource Brush.Border.DisabledChecked}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style BasedOn="{StaticResource {x:Type Control}}" TargetType="ProgressBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Background.Checked}" />
        <Setter Property="Background" Value="{StaticResource Brush.Background.Normal}" />
        <Setter Property="Template" Value="{StaticResource Template.ProgressBar}" />
    </Style>


    <!--  ============== SLIDER ==============  -->

    <Style TargetType="Thumb" x:Key="Style.Slider.Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent" Margin="-10">
                        <Rectangle
                            Fill="{StaticResource Brush.Thumb.Normal}"
                            Height="20"
                            Stroke="{StaticResource Brush.Element.Dark.Normal}"
                            StrokeThickness="1"
                            Width="10"
                            x:Name="ThumbRectangle" />
                        <!--  Определение визуальных состояний  -->
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <!--  Нормальное состояние  -->
                                <VisualState x:Name="Normal" />

                                <!--  Состояние перетаскивания  -->
                                <VisualState x:Name="Dragging">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource Brush.Thumb.Pressed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>

                                <!--  Состояние отключённого элемента  -->
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource Brush.Thumb.Disabled}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        BasedOn="{StaticResource {x:Type RepeatButton}}"
        TargetType="RepeatButton"
        x:Key="Style.Slider.RepeatButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Delay" Value="250" />
        <Setter Property="Interval" Value="100" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Corner.Border2}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Horizontal slider  -->
    <ControlTemplate TargetType="Slider" x:Key="Template.Slider.Horizontal">
        <Grid
            Height="30"
            Margin="8,0"
            x:Name="TemplateRoot">
            <Border
                Background="{TemplateBinding Background}"
                CornerRadius="5"
                Grid.Row="1"
                Height="10"
                MaxHeight="10"
                x:Name="Background" />
            <Track
                Grid.RowSpan="3"
                Orientation="Horizontal"
                x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton
                        Background="{TemplateBinding Foreground}"
                        Command="Slider.DecreaseLarge"
                        Margin="0,0,-1,0"
                        Padding="1,9"
                        Style="{StaticResource Style.Slider.RepeatButton}"
                        x:Name="DecreaseButton" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton
                        Background="Transparent"
                        Command="Slider.IncreaseLarge"
                        Padding="1,9"
                        Style="{StaticResource Style.Slider.RepeatButton}"
                        x:Name="IncreaseButton" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb
                        Background="{TemplateBinding Foreground}"
                        Height="20"
                        Style="{StaticResource Style.Slider.Thumb}"
                        Width="10"
                        x:Name="Thumb" />
                </Track.Thumb>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsDirectionReversed" Value="True">
                <Setter Property="Margin" TargetName="DecreaseButton" Value="-2,0,0,0" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" TargetName="Thumb" Value="{StaticResource Brush.Border.Over}" />
            </Trigger>
            <Trigger Property="TickPlacement" Value="TopLeft">
                <Setter Property="Visibility" TargetName="TopTicks" Value="Visible" />
            </Trigger>
            <Trigger Property="TickPlacement" Value="BottomRight">
                <Setter Property="Visibility" TargetName="BottomTicks" Value="Visible" />
            </Trigger>
            <Trigger Property="TickPlacement" Value="Both">
                <Setter Property="Visibility" TargetName="TopTicks" Value="Visible" />
                <Setter Property="Visibility" TargetName="BottomTicks" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" TargetName="DecreaseButton" Value="{DynamicResource Brush.Border.DisabledChecked}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  Vertical slider  -->
    <ControlTemplate TargetType="Slider" x:Key="Template.Slider.Vertical">
        <Grid
            Margin="0,8"
            Width="20"
            x:Name="TemplateRoot">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border
                Background="{TemplateBinding Background}"
                CornerRadius="{DynamicResource Corner.Border2}"
                Grid.Column="1"
                Width="2"
                x:Name="Background" />
            <Border Grid.Column="0" Width="8">
                <TickBar
                    Fill="{TemplateBinding Background}"
                    HorizontalAlignment="Left"
                    Placement="Left"
                    Visibility="Hidden"
                    Width="4"
                    x:Name="LeftTicks" />
            </Border>
            <Border Grid.Column="2" Width="8">
                <TickBar
                    Fill="{TemplateBinding Background}"
                    HorizontalAlignment="Right"
                    Placement="Right"
                    Visibility="Hidden"
                    Width="4"
                    x:Name="RightTicks" />
            </Border>
            <Track
                Grid.ColumnSpan="3"
                Orientation="Vertical"
                x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton
                        Background="{TemplateBinding Foreground}"
                        Command="Slider.DecreaseLarge"
                        Margin="0,0,0,0"
                        Padding="9,0"
                        Style="{StaticResource Style.Slider.RepeatButton}"
                        x:Name="DecreaseButton" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton
                        Background="Transparent"
                        Command="Slider.IncreaseLarge"
                        Margin="0,0,0,0"
                        Padding="9,0"
                        Style="{StaticResource Style.Slider.RepeatButton}"
                        x:Name="IncreaseButton" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb
                        Background="{TemplateBinding Foreground}"
                        Style="{StaticResource Style.Slider.Thumb}"
                        x:Name="Thumb" />
                </Track.Thumb>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsDirectionReversed" Value="True">
                <Setter Property="Margin" TargetName="DecreaseButton" Value="0,0,0,-2" />
            </Trigger>
            <Trigger Property="TickPlacement" Value="TopLeft">
                <Setter Property="Visibility" TargetName="LeftTicks" Value="Visible" />
            </Trigger>
            <Trigger Property="TickPlacement" Value="BottomRight">
                <Setter Property="Visibility" TargetName="RightTicks" Value="Visible" />
            </Trigger>
            <Trigger Property="TickPlacement" Value="Both">
                <Setter Property="Visibility" TargetName="LeftTicks" Value="Visible" />
                <Setter Property="Visibility" TargetName="RightTicks" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" TargetName="DecreaseButton" Value="{DynamicResource Brush.Border.DisabledChecked}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style BasedOn="{StaticResource {x:Type Control}}" TargetType="Slider">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Background.Checked}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Panel.Background}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Style.Focus.Outer.Uniform}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Template" Value="{StaticResource Template.Slider.Horizontal}" />
            </Trigger>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Template" Value="{StaticResource Template.Slider.Vertical}" />
            </Trigger>
        </Style.Triggers>
    </Style>


    <!--  ============== BOX ==============  -->

    <!--  GroupBox  -->
    <ControlTemplate TargetType="GroupBox" x:Key="Template.GroupBox.NoHeader">
        <Grid>
            <Rectangle
                RadiusX="4"
                RadiusY="4"
                Stroke="{TemplateBinding BorderBrush}"
                StrokeThickness="{DynamicResource Size.GroupBox.Border}" />
            <Decorator Margin="5">
                <ContentPresenter Margin="{TemplateBinding Padding}" />
            </Decorator>
        </Grid>
    </ControlTemplate>
    <ControlTemplate TargetType="GroupBox" x:Key="Template.GroupBox">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" MaxHeight="5" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition MaxWidth="9" Width="9" />
            </Grid.ColumnDefinitions>
            <Path
                Data="M8,0L4,0A4,4,0,0,0,0,4"
                Grid.Column="0"
                Grid.Row="1"
                Margin="0,4,0,-4"
                Stretch="Fill"
                Stroke="{TemplateBinding BorderBrush}"
                StrokeEndLineCap="Square"
                StrokeStartLineCap="Square"
                StrokeThickness="{DynamicResource Size.GroupBox.Border}"
                VerticalAlignment="Bottom" />
            <Border
                Background="{TemplateBinding BorderBrush}"
                Grid.Column="0"
                Grid.Row="2"
                Grid.RowSpan="2"
                HorizontalAlignment="Left"
                Margin="0,4,0,0"
                Width="{DynamicResource Size.GroupBox.Border}" />
            <Path
                Data="M0,0A4,4,0,0,0,4,4L8,4"
                Grid.Column="0"
                Grid.Row="4"
                Stretch="Fill"
                Stroke="{TemplateBinding BorderBrush}"
                StrokeEndLineCap="Square"
                StrokeStartLineCap="Square"
                StrokeThickness="{DynamicResource Size.GroupBox.Border}" />
            <Border
                Background="{TemplateBinding BorderBrush}"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Grid.Row="5"
                Height="{DynamicResource Size.GroupBox.Border}"
                VerticalAlignment="Bottom" />
            <Path
                Data="M0,4L4,4A4,4,0,0,0,8,0"
                Grid.Column="3"
                Grid.Row="4"
                Stretch="Fill"
                Stroke="{TemplateBinding BorderBrush}"
                StrokeEndLineCap="Square"
                StrokeStartLineCap="Square"
                StrokeThickness="{DynamicResource Size.GroupBox.Border}" />
            <Border
                Background="{TemplateBinding BorderBrush}"
                Grid.Column="3"
                Grid.Row="2"
                Grid.RowSpan="2"
                HorizontalAlignment="Right"
                Margin="0,4,0,0"
                Width="{DynamicResource Size.GroupBox.Border}" />
            <Path
                Data="M8,4A4,4,0,0,0,4,0L0,0"
                Grid.Column="3"
                Grid.Row="1"
                Margin="0,4,0,-4"
                Stretch="Fill"
                Stroke="{TemplateBinding BorderBrush}"
                StrokeEndLineCap="Square"
                StrokeStartLineCap="Square"
                StrokeThickness="{DynamicResource Size.GroupBox.Border}"
                VerticalAlignment="Bottom" />
            <Border
                Background="{TemplateBinding BorderBrush}"
                Grid.Column="2"
                Grid.Row="1"
                Height="{DynamicResource Size.GroupBox.Border}"
                VerticalAlignment="Bottom" />
            <Border
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Grid.Row="3"
                Margin="-4,0"
                x:Name="ContentHost">
                <ContentPresenter Margin="{TemplateBinding Padding}" />
            </Border>
            <ContentPresenter
                ContentSource="Header"
                Grid.Column="1"
                Grid.Row="0"
                Grid.RowSpan="3"
                Margin="4,0"
                TextElement.FontSize="{DynamicResource Font.Size.Header}"
                x:Name="HeaderHost" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Header" Value="{x:Null}">
                <Setter Property="Margin" TargetName="HeaderHost" Value="0" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Disabled}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Disabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style BasedOn="{StaticResource {x:Type HeaderedContentControl}}" TargetType="GroupBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Normal}" />
        <Setter Property="Padding" Value="{DynamicResource Margin.Focus.Padded}" />
        <Setter Property="Template" Value="{StaticResource Template.GroupBox}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Panel.Background}" />


        <Style.Triggers>
            <Trigger Property="Header" Value="{x:Null}">
                <Setter Property="Template" Value="{StaticResource Template.GroupBox.NoHeader}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>