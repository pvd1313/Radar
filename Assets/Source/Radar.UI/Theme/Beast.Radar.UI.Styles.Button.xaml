<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <!--=== BASE TEMPLATE ===-->





    <!--=== TEMPLATE ===-->

    <!--  template: button & repeatButton  -->
    <ControlTemplate TargetType="ButtonBase" x:Key="Template.ButtonBase">
        <Grid RenderTransformOrigin="0.5,0.5" x:Name="TemplateRoot">
            <Grid.RenderTransform>
                <ScaleTransform />
            </Grid.RenderTransform>
            <Border
                Background="{TemplateBinding Background}"
                CornerRadius="{DynamicResource Corner.Border0}"
                x:Name="Border" />
            <ContentPresenter
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                Margin="{TemplateBinding Padding}"
                TextElement.Foreground="{TemplateBinding Foreground}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                x:Name="PART_ContentPresenter" />
            <Rectangle
                Fill="{TemplateBinding BorderBrush}"
                Height="3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                x:Name="BottomStripe" />
        </Grid>
        <ControlTemplate.Resources>
            <Storyboard x:Key="Anim.Press">
                <DoubleAnimation
                    DecelerationRatio="0.25"
                    Duration="0:0:0.1"
                    Storyboard.TargetName="TemplateRoot"
                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                    To="0.99" />
                <DoubleAnimation
                    DecelerationRatio="0.25"
                    Duration="0:0:0.1"
                    Storyboard.TargetName="TemplateRoot"
                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                    To="0.99" />
            </Storyboard>
            <Storyboard x:Key="Anim.Release">
                <DoubleAnimation
                    DecelerationRatio="1"
                    Duration="0:0:0.2"
                    Storyboard.TargetName="TemplateRoot"
                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                    To="1" />
                <DoubleAnimation
                    DecelerationRatio="1"
                    Duration="0:0:0.2"
                    Storyboard.TargetName="TemplateRoot"
                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                    To="1" />
            </Storyboard>
        </ControlTemplate.Resources>
        <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource Anim.Press}" />
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource Anim.Release}" />
                </Trigger.ExitActions>
                <Setter Property="Background" TargetName="Border" Value="{DynamicResource Brush.Button.Normal}" />
                <Setter Property="CornerRadius" TargetName="Border" Value="{DynamicResource Corner.Border0}" />
                <Setter Property="Fill" TargetName="BottomStripe" Value="{DynamicResource Brush.Accent.Pressed}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Disabled}" />
                <Setter Property="Fill" TargetName="BottomStripe" Value="{DynamicResource Brush.Element.Light.Disabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  template: triangle Button  -->
    <ControlTemplate TargetType="ButtonBase" x:Key="Template.TriangleButton">
        <Grid
            Background="Transparent"
            RenderTransformOrigin="0.5,0.5"
            x:Name="TemplateRoot">
            <Grid.RenderTransform>
                <ScaleTransform />
            </Grid.RenderTransform>
            <Border
                Background="Transparent"
                Height="{Binding ActualHeight, RelativeSource={RelativeSource TemplatedParent}}"
                Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" />
            <Path
                Data="M 0,20 L 20,0 L 40,20 Z"
                Fill="{TemplateBinding Background}"
                HorizontalAlignment="Center"
                RenderTransformOrigin="0.5,0.5"
                Stretch="Uniform"
                Stroke="{TemplateBinding BorderBrush}"
                StrokeThickness="{StaticResource Size.Button.Border}"
                VerticalAlignment="Center"
                x:Name="TrianglePath">
                <Path.RenderTransform>
                    <TransformGroup>
                        <RotateTransform Angle="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ScaleTransform x:Name="TriangleScaleTransform" />
                    </TransformGroup>
                </Path.RenderTransform>
            </Path>
            <ContentPresenter
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                Margin="{TemplateBinding Padding}"
                TextElement.Foreground="{TemplateBinding Foreground}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                x:Name="PART_ContentPresenter" />
        </Grid>
        <ControlTemplate.Resources>
            <Storyboard x:Key="Anim.Press">
                <DoubleAnimation
                    DecelerationRatio="0.25"
                    Duration="0:0:0.1"
                    Storyboard.TargetName="TriangleScaleTransform"
                    Storyboard.TargetProperty="ScaleX"
                    To="0.95" />
                <DoubleAnimation
                    DecelerationRatio="0.25"
                    Duration="0:0:0.1"
                    Storyboard.TargetName="TriangleScaleTransform"
                    Storyboard.TargetProperty="ScaleY"
                    To="0.95" />
            </Storyboard>
            <Storyboard x:Key="Anim.Release">
                <DoubleAnimation
                    DecelerationRatio="1"
                    Duration="0:0:0.2"
                    Storyboard.TargetName="TriangleScaleTransform"
                    Storyboard.TargetProperty="ScaleX"
                    To="1" />
                <DoubleAnimation
                    DecelerationRatio="1"
                    Duration="0:0:0.2"
                    Storyboard.TargetName="TriangleScaleTransform"
                    Storyboard.TargetProperty="ScaleY"
                    To="1" />
            </Storyboard>
        </ControlTemplate.Resources>
        <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource Anim.Press}" />
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource Anim.Release}" />
                </Trigger.ExitActions>
                <Setter Property="Fill" TargetName="TrianglePath" Value="{DynamicResource Brush.Accent.Pressed}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Pressed}" />
                <Setter Property="Background" Value="{DynamicResource Brush.Accent.Pressed}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Pressed}" />
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Disabled}" />
                <Setter Property="Fill" TargetName="TrianglePath" Value="{DynamicResource Brush.Element.Light.Disabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  template: background button  -->
    <ControlTemplate TargetType="Button" x:Key="Template.Button.Background">
        <Grid RenderTransformOrigin="0.5,0.5" x:Name="TemplateRoot">
            <Border
                Background="{StaticResource Brush.Panel.Background}"
                Opacity="{TemplateBinding Opacity}"
                x:Name="Border" />
        </Grid>
    </ControlTemplate>

    <!--  template: toggle button  -->
    <ControlTemplate TargetType="ToggleButton" x:Key="Template.ToggleButton">
        <Grid RenderTransformOrigin="0.5,0.5" x:Name="TemplateRoot">
            <Grid.RenderTransform>
                <ScaleTransform />
            </Grid.RenderTransform>
            <Border
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{DynamicResource Corner.Border0}"
                x:Name="Border" />
            <ContentPresenter
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                Margin="{TemplateBinding Padding}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                x:Name="PART_ContentPresenter" />
        </Grid>
        <ControlTemplate.Resources>
            <Storyboard x:Key="Anim.Press">
                <DoubleAnimation
                    DecelerationRatio="0.25"
                    Duration="0:0:0.1"
                    Storyboard.TargetName="TemplateRoot"
                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                    To="0.99" />
                <DoubleAnimation
                    DecelerationRatio="0.25"
                    Duration="0:0:0.1"
                    Storyboard.TargetName="TemplateRoot"
                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                    To="0.99" />
            </Storyboard>
            <Storyboard x:Key="Anim.Release">
                <DoubleAnimation
                    DecelerationRatio="1"
                    Duration="0:0:0.2"
                    Storyboard.TargetName="TemplateRoot"
                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                    To="1" />
                <DoubleAnimation
                    DecelerationRatio="1"
                    Duration="0:0:0.2"
                    Storyboard.TargetName="TemplateRoot"
                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                    To="1" />
            </Storyboard>
        </ControlTemplate.Resources>
        <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource Anim.Press}" />
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource Anim.Release}" />
                </Trigger.ExitActions>
                <Setter Property="Background" TargetName="Border" Value="{DynamicResource Brush.Accent.Pressed}" />
                <Setter Property="BorderBrush" TargetName="Border" Value="{DynamicResource Brush.Border.Pressed}" />
                <Setter Property="BorderThickness" TargetName="Border" Value="{DynamicResource Border.Normal}" />
                <Setter Property="CornerRadius" TargetName="Border" Value="{DynamicResource Corner.Border0}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" TargetName="Border" Value="{DynamicResource Brush.Accent.Normal}" />
                <Setter Property="BorderBrush" TargetName="Border" Value="{DynamicResource Brush.Border.Checked}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Disabled}" />
                <Setter Property="BorderBrush" TargetName="Border" Value="{DynamicResource Brush.Border.Disabled}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="False" />
                    <Condition Property="IsChecked" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.DisabledChecked}" />
                <Setter Property="BorderBrush" TargetName="Border" Value="{DynamicResource Brush.Border.DisabledChecked}" />
            </MultiTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  template: close button  -->
    <ControlTemplate TargetType="Button" x:Key="Template.Button.Close">
        <Grid RenderTransformOrigin="0.5,0.5" x:Name="TemplateRoot">
            <Grid.RenderTransform>
                <ScaleTransform />
            </Grid.RenderTransform>
            <Border
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{StaticResource Border.Normal}"
                CornerRadius="{StaticResource Corner.Border0}"
                x:Name="Border" />
            <Grid
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                x:Name="CrossGrid">
                <Path
                    Data="M 0,0 L 1,1 M 1,0 L 0,1"
                    Height="20"
                    Stretch="Uniform"
                    Stroke="{TemplateBinding Foreground}"
                    StrokeThickness="3"
                    Width="20" />
            </Grid>

        </Grid>
        <ControlTemplate.Resources>
            <Storyboard x:Key="Anim.Press">
                <DoubleAnimation
                    DecelerationRatio="0.25"
                    Duration="0:0:0.1"
                    Storyboard.TargetName="TemplateRoot"
                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                    To="0.9" />
                <DoubleAnimation
                    DecelerationRatio="0.25"
                    Duration="0:0:0.1"
                    Storyboard.TargetName="TemplateRoot"
                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                    To="0.9" />
            </Storyboard>

            <Storyboard x:Key="Anim.Release">
                <DoubleAnimation
                    DecelerationRatio="1"
                    Duration="0:0:0.2"
                    Storyboard.TargetName="TemplateRoot"
                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                    To="1" />
                <DoubleAnimation
                    DecelerationRatio="1"
                    Duration="0:0:0.2"
                    Storyboard.TargetName="TemplateRoot"
                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                    To="1" />
            </Storyboard>
        </ControlTemplate.Resources>

        <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource Anim.Press}" />
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource Anim.Release}" />
                </Trigger.ExitActions>
                <Setter Property="Background" TargetName="Border" Value="{DynamicResource Brush.Button.Normal}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Disabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  template: radio button  -->
    <ControlTemplate TargetType="RadioButton" x:Key="Template.RadioButtonBase">
        <Grid RenderTransformOrigin="0.5,0.5" x:Name="TemplateRoot">
            <Grid.RenderTransform>
                <ScaleTransform />
            </Grid.RenderTransform>

            <Border
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Corner.Border0}"
                x:Name="Border" />

            <ContentPresenter
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                Margin="{TemplateBinding Padding}"
                TextElement.Foreground="{TemplateBinding Foreground}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                x:Name="PART_ContentPresenter" />

            <!--  Bottom Stripe  -->
            <Rectangle
                Fill="{TemplateBinding BorderBrush}"
                Height="3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                x:Name="BottomStripe" />
        </Grid>

        <ControlTemplate.Resources>
            <!--  Animation for button press  -->
            <Storyboard x:Key="Anim.Press">
                <DoubleAnimation
                    DecelerationRatio="0.25"
                    Duration="0:0:0.1"
                    Storyboard.TargetName="TemplateRoot"
                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                    To="0.99" />
                <DoubleAnimation
                    DecelerationRatio="0.25"
                    Duration="0:0:0.1"
                    Storyboard.TargetName="TemplateRoot"
                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                    To="0.99" />
            </Storyboard>

            <Storyboard x:Key="Anim.Release">
                <DoubleAnimation
                    DecelerationRatio="1"
                    Duration="0:0:0.2"
                    Storyboard.TargetName="TemplateRoot"
                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                    To="1" />
                <DoubleAnimation
                    DecelerationRatio="1"
                    Duration="0:0:0.2"
                    Storyboard.TargetName="TemplateRoot"
                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                    To="1" />
            </Storyboard>
        </ControlTemplate.Resources>

        <ControlTemplate.Triggers>
            <!--  When button is pressed  -->
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource Anim.Press}" />
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource Anim.Release}" />
                </Trigger.ExitActions>
                <Setter Property="Background" TargetName="Border" Value="{DynamicResource Brush.Button.Normal}" />
                <Setter Property="CornerRadius" TargetName="Border" Value="{DynamicResource Corner.Border0}" />
                <Setter Property="Fill" TargetName="BottomStripe" Value="{DynamicResource Brush.Accent.Pressed}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Pressed}" />
            </Trigger>

            <!--  When radio button is selected (IsChecked)  -->
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" TargetName="Border" Value="{DynamicResource Brush.Accent.Normal}" />
                <Setter Property="Fill" TargetName="BottomStripe" Value="{DynamicResource Brush.Accent.Pressed}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Dark.Normal}" />
            </Trigger>

            <!--  When radio button is disabled  -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Disabled}" />
                <Setter Property="Fill" TargetName="BottomStripe" Value="{DynamicResource Brush.Element.Light.Disabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>






    <!--=== BASE STYLE ===-->

    <!--  base style : toggle button -->
    <Style BasedOn="{StaticResource {x:Type ContentControl}}" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="{DynamicResource Brush.Element.Dark.Disabled}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Normal}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Border.Normal}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="8,7" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template" Value="{StaticResource Template.ToggleButton}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Style.Focus.Outer.Uniform}" />
    </Style>





    <!--=== STYLE ===-->

    <!--  style: base Button  -->
    <Style BasedOn="{StaticResource {x:Type ContentControl}}" TargetType="ButtonBase" x:Key="Style.ButtonBase">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="{DynamicResource Brush.Button.Normal}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0,0" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template" Value="{StaticResource Template.ButtonBase}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Style.Focus.Outer.Uniform}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Light.Normal}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Header}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Normal}" />
    </Style>

    <!--  style: triangle Button  -->
    <Style BasedOn="{StaticResource {x:Type ContentControl}}" TargetType="ButtonBase" x:Key="Style.Button.Triangle">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Normal}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="40" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template" Value="{StaticResource Template.TriangleButton}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Style.Focus.Outer.Uniform}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Light.Normal}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Header}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Normal}" />
    </Style>

    <!--  style: icon button  -->
    <Style TargetType="Button" x:Key="Style.Button.Icon">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Height="{TemplateBinding Height}" Width="{TemplateBinding Width}">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Corner.Border1}" />
                        <Rectangle
                            Fill="{TemplateBinding Foreground}"
                            Height="{TemplateBinding Height}"
                            Margin="2,2,2,2"
                            RenderTransformOrigin="0.5,0.5"
                            Width="{TemplateBinding Width}">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stretch="UniformToFill" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  style: button close -->
    <Style TargetType="Button" x:Key="Style.Button.Close">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="{DynamicResource Brush.Button.Normal}" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Normal}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Style.Focus.Outer.Uniform}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Light.Normal}" />
        <Setter Property="Template" Value="{StaticResource Template.Button.Close}" />
    </Style>

    <!--  style: toggle button icon  -->
    <Style TargetType="ToggleButton" x:Key="Style.ToggleButton.Icon">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Height="{TemplateBinding Height}" Width="{TemplateBinding Width}">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            CornerRadius="{StaticResource Corner.Border1}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                            <Setter Property="BorderThickness" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <Rectangle
                            Fill="{TemplateBinding Foreground}"
                            Height="{Binding IconHeight, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=16}"
                            Margin="3,3,3,3"
                            RenderTransformOrigin="0.5,0.5"
                            Width="{Binding IconWidth, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=16}">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stretch="UniformToFill" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  style: toggle button text  -->
    <Style TargetType="ToggleButton" x:Key="Style.ToggleButton.Text">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Height="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Height}" Width="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Width}">
                        <Border
                            Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Background}"
                            BorderBrush="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=BorderBrush}"
                            CornerRadius="{StaticResource Corner.Border1}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                            <Setter Property="BorderThickness" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <TextBlock
                            FontSize="20"
                            HorizontalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5"
                            Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}"
                            VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                            <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=BorderBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="False">
                                            <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  style: radio button base-->
    <Style TargetType="RadioButton" x:Key="Style.RadioButton.Base">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="{DynamicResource Brush.Button.Normal}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0,0" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template" Value="{StaticResource Template.RadioButtonBase}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Style.Focus.Outer.Uniform}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Light.Normal}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Header}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Normal}" />
    </Style>


</ResourceDictionary>