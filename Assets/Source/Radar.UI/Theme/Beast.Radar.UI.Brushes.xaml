<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Beast.Radar.UI.Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="Brush.Text.Light.Normal" Color="{StaticResource Color.Gray3}" />
    <SolidColorBrush x:Key="Brush.Text.Dark.Normal" Color="{StaticResource Color.Black}" />

    <SolidColorBrush x:Key="Brush.Panel.Dark.Normal" Color="{StaticResource Color.Black}" />
    <SolidColorBrush x:Key="Brush.Panel.Light.Normal" Color="{StaticResource Color.Gray0}" />
    <SolidColorBrush x:Key="Brush.Panel.Background" Color= "{StaticResource Color.Dark.Alpa}" />

    <SolidColorBrush x:Key="Brush.Button.Normal" Color="{StaticResource Color.Dark.Alpa}" />
    <SolidColorBrush x:Key="Brush.Button.Pressed" Color= "{StaticResource Color.Dark.Alpa}" />
    <SolidColorBrush x:Key="Brush.Button.Disabled" Color= "{StaticResource Color.Dark.Alpa}" />

    <SolidColorBrush x:Key="Brush.Element.Dark.Normal" Color="{StaticResource Color.Black}"  />
    <SolidColorBrush x:Key="Brush.Element.Dark.Disabled" Color="{StaticResource Color.Dark.Alpa}" />
    <SolidColorBrush x:Key="Brush.Element.Light.Normal" Color="{StaticResource Color.White}" />
    <SolidColorBrush x:Key="Brush.Element.Light.Disabled" Color="{StaticResource Color.Gray3}" />

    <SolidColorBrush x:Key="Brush.Accent.Normal" Color="{StaticResource Color.Accent0}"/>
    <SolidColorBrush x:Key="Brush.Accent.Over" Color="{StaticResource Color.Accent1}"/>
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="{StaticResource Color.Accent2}"/>
    <SolidColorBrush x:Key="Brush.Accent.Disabled" Color="{StaticResource Color.Accent3}"/>


    <SolidColorBrush x:Key="Brush.Thumb.Normal" Color="{StaticResource Color.Accent0}"/>
    <SolidColorBrush x:Key="Brush.Thumb.Over" Color="{StaticResource Color.Accent1}"/>
    <SolidColorBrush x:Key="Brush.Thumb.Pressed" Color="{StaticResource Color.Accent2}"/>
    <SolidColorBrush x:Key="Brush.Thumb.Disabled" Color="{StaticResource Color.Accent3}"/>

    <!--  Noesis  -->

    <SolidColorBrush Color="{StaticResource Color.Black}" x:Key="Brush.Foreground.Normal" />
    <SolidColorBrush Color="{StaticResource Color.Gray2}" x:Key="Brush.Foreground.Placeholder" />
    <SolidColorBrush Color="{StaticResource Color.Gray2}" x:Key="Brush.Foreground.Disabled" />
    <SolidColorBrush Color="{StaticResource Color.Accent0}" x:Key="Brush.Foreground.DisabledChecked" />
    <SolidColorBrush Color="{StaticResource Color.Gray4}" x:Key="Brush.Foreground.DisabledPlaceholder" />

    <SolidColorBrush Color="{StaticResource Color.White}" x:Key="Brush.Window.Background" />

    <SolidColorBrush Color="{StaticResource Color.Gray5}" x:Key="Brush.TextBox.Normal" />
    <SolidColorBrush Color="{StaticResource Color.White}" x:Key="Brush.TextBox.Focused" />

    <SolidColorBrush Color="{StaticResource Color.Gray0}" x:Key="Brush.Glyph.Normal" />
    <SolidColorBrush Color="{StaticResource Color.Black}" x:Key="Brush.Glyph.Over" />
    <SolidColorBrush Color="{StaticResource Color.White}" x:Key="Brush.Glyph.Pressed" />
    <SolidColorBrush Color="{StaticResource Color.White}" x:Key="Brush.Glyph.Checked" />
    <SolidColorBrush Color="{StaticResource Color.Gray2}" x:Key="Brush.Glyph.Disabled" />
    <SolidColorBrush Color="{StaticResource Color.Gray4}" x:Key="Brush.Glyph.DisabledChecked" />

    <SolidColorBrush Color="{StaticResource Color.Gray5}" x:Key="Brush.Background.Normal" />
    <SolidColorBrush Color="{StaticResource Color.Gray2}" x:Key="Brush.Background.Disabled" />
    <SolidColorBrush Color="{StaticResource Color.Gray3}" x:Key="Brush.Background.Pressed" />
    <SolidColorBrush Color="{StaticResource Color.Accent2}" x:Key="Brush.Background.Checked" />
    <SolidColorBrush Color="{StaticResource Color.White}" x:Key="Brush.Background.Popup" />

    <SolidColorBrush Color="{StaticResource Color.Black}" x:Key="Brush.Border.Normal" />
    <SolidColorBrush Color="{StaticResource Color.Black}" x:Key="Brush.Border.Over" />
    <SolidColorBrush Color="{StaticResource Color.Black}" x:Key="Brush.Border.Pressed" />
    <SolidColorBrush Color="{StaticResource Color.Black}" x:Key="Brush.Border.Checked" />
    <SolidColorBrush Color="{StaticResource Color.Black}" x:Key="Brush.Border.Focus" />
    <SolidColorBrush Color="{StaticResource Color.Black}" x:Key="Brush.Border.FocusAccent" />
    <SolidColorBrush Color="{StaticResource Color.Black}" x:Key="Brush.Border.Disabled" />
    <SolidColorBrush Color="{StaticResource Color.Dark.Alpa}" x:Key="Brush.Border.DisabledChecked" />
    <SolidColorBrush Color="{StaticResource Color.Black}" x:Key="Brush.Border.Popup" />

    <SolidColorBrush Color="{StaticResource Color.Gray5}" x:Key="Brush.Track.Normal" />

    <SolidColorBrush Color="{StaticResource Color.Gray5}" x:Key="Brush.Header.Normal" />
    <SolidColorBrush Color="{StaticResource Color.White}" x:Key="Brush.Header.Over" />
    <SolidColorBrush Color="{StaticResource Color.Gray5}" x:Key="Brush.Header.Pressed" />
    <SolidColorBrush Color="{StaticResource Color.Accent3}" x:Key="Brush.Header.Checked" />
    <SolidColorBrush Color="{StaticResource Color.Accent2}" x:Key="Brush.Header.CheckedOver" />
    <SolidColorBrush Color="{StaticResource Color.Accent}" x:Key="Brush.Header.CheckedPressed" />

    <SolidColorBrush Color="{StaticResource Color.Accent}" x:Key="Brush.Hyperlink.Normal" />
    <SolidColorBrush Color="{StaticResource Color.Black}" x:Key="Brush.Hyperlink.Over" />


    <SolidColorBrush Color="{StaticResource Color.Gray5}" x:Key="Brush.Item.Over" />
    <SolidColorBrush Color="{StaticResource Color.Accent3}" x:Key="Brush.Item.Selected" />
    <SolidColorBrush Color="{StaticResource Color.Accent2}" x:Key="Brush.Item.SelectedOver" />

    <SolidColorBrush Color="{StaticResource Color.Gray5}" x:Key="Brush.ComboBox.Normal" />
    <SolidColorBrush Color="{StaticResource Color.Gray4}" x:Key="Brush.ComboBox.Over" />
    <SolidColorBrush Color="{StaticResource Color.Gray3}" x:Key="Brush.ComboBox.Pressed" />
    <SolidColorBrush Color="{StaticResource Color.White}" x:Key="Brush.ComboBox.Edit" />

    <SolidColorBrush Color="{StaticResource Color.Gray3}" x:Key="Brush.TabControl.Normal" />
    <SolidColorBrush Color="{StaticResource Color.Gray5}" x:Key="Brush.TabControl.Over" />
    <SolidColorBrush Color="{StaticResource Color.Accent2}" x:Key="Brush.TabControl.Selected" />

    <SolidColorBrush Color="{StaticResource Color.Gray1}" x:Key="Brush.TreeView.Collapsed" />
    <SolidColorBrush Color="{StaticResource Color.Black}" x:Key="Brush.TreeView.Expanded" />
    <SolidColorBrush Color="{StaticResource Color.Accent}" x:Key="Brush.TreeView.Over" />
    <SolidColorBrush Color="{StaticResource Color.Accent0}" x:Key="Brush.TreeView.SelectedOver" />

    <SolidColorBrush Color="{StaticResource Color.Gray5}" x:Key="Brush.ToolBar.Normal" />
    <SolidColorBrush Color="{StaticResource Color.Gray3}" x:Key="Brush.ToolBar.Over" />
    <SolidColorBrush Color="{StaticResource Color.Gray5}" x:Key="Brush.ToolBar.Pressed" />
    <SolidColorBrush Color="{StaticResource Color.Accent2}" x:Key="Brush.ToolBar.Checked" />

</ResourceDictionary>