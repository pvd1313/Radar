<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--=== BASE TEMPLATE ===-->



    <!--=== STYLE ===-->

    <!--  style: thumb  -->
    <Style TargetType="Thumb" x:Key="Style.ScrollBar.Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Border Background="{DynamicResource Brush.Thumb.Normal}" x:Name="Thumb" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" TargetName="Thumb" Value="{DynamicResource Brush.Thumb.Over}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter Property="Background" TargetName="Thumb" Value="{DynamicResource Brush.Thumb.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" TargetName="Thumb" Value="{DynamicResource Brush.Thumb.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  style: line button  -->
    <Style BasedOn="{StaticResource {x:Type RepeatButton}}" TargetType="RepeatButton" x:Key="Style.ScrollBar.LineButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Delay" Value="250" />
        <Setter Property="Interval" Value="100" />
        <Setter Property="Width" Value="{DynamicResource Size.ScrollBar}" />
        <Setter Property="Height" Value="{DynamicResource Size.ScrollBar}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" x:Name="Border">
                        <Path
                            Data="{TemplateBinding Content}"
                            HorizontalAlignment="Center"
                            Stroke="{DynamicResource Brush.Glyph.Normal}"
                            VerticalAlignment="Center"
                            x:Name="Arrow" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" TargetName="Border" Value="{DynamicResource Brush.Background.Normal}" />
                            <Setter Property="Stroke" TargetName="Arrow" Value="{DynamicResource Brush.Glyph.Over}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" TargetName="Border" Value="{DynamicResource Brush.Thumb.Pressed}" />
                            <Setter Property="Stroke" TargetName="Arrow" Value="{DynamicResource Brush.Glyph.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Stroke" TargetName="Arrow" Value="{DynamicResource Brush.Glyph.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  style: page button  -->
    <Style BasedOn="{StaticResource {x:Type RepeatButton}}" TargetType="RepeatButton" x:Key="Style.ScrollBar.PageButton">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Delay" Value="250" />
        <Setter Property="Interval" Value="100" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!--=== TEMPLATE ===-->

    <!--  template: scroll bar horizontal  -->
    <ControlTemplate TargetType="ScrollBar" x:Key="Template.ScrollBar.Horizontal">
        <ControlTemplate.Resources>
            <Geometry x:Key="Geometry.LeftArrow">M4,0L0,4 4,8</Geometry>
            <Geometry x:Key="Geometry.RightArrow">M0,0 L4,4 0,8</Geometry>
            <Storyboard BeginTime="0:0:0.1" x:Key="Anim.ExpandBar">
                <DoubleAnimation
                    AccelerationRatio="0.75"
                    DecelerationRatio="0.25"
                    Duration="0:0:0.1"
                    Storyboard.TargetName="Background"
                    Storyboard.TargetProperty="Opacity"
                    To="1" />
                <DoubleAnimation
                    AccelerationRatio="0.75"
                    DecelerationRatio="0.25"
                    Duration="0:0:0.1"
                    Storyboard.TargetName="LineLeftButton"
                    Storyboard.TargetProperty="Opacity"
                    To="1" />
                <DoubleAnimation
                    AccelerationRatio="0.75"
                    DecelerationRatio="0.25"
                    Duration="0:0:0.1"
                    Storyboard.TargetName="LineRightButton"
                    Storyboard.TargetProperty="Opacity"
                    To="1" />
                <DoubleAnimation
                    DecelerationRatio="0.5"
                    Duration="0:0:0.1"
                    Storyboard.TargetName="Thumb"
                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                    To="1" />
            </Storyboard>
            <Storyboard BeginTime="0:0:2" x:Key="Anim.CollapseBar">
                <DoubleAnimation
                    AccelerationRatio="0.75"
                    DecelerationRatio="0.25"
                    Duration="0:0:0.15"
                    Storyboard.TargetName="Background"
                    Storyboard.TargetProperty="Opacity"
                    To="0" />
                <DoubleAnimation
                    AccelerationRatio="0.75"
                    DecelerationRatio="0.25"
                    Duration="0:0:0.15"
                    Storyboard.TargetName="LineLeftButton"
                    Storyboard.TargetProperty="Opacity"
                    To="0" />
                <DoubleAnimation
                    AccelerationRatio="0.75"
                    DecelerationRatio="0.25"
                    Duration="0:0:0.15"
                    Storyboard.TargetName="LineRightButton"
                    Storyboard.TargetProperty="Opacity"
                    To="0" />
                <DoubleAnimation
                    DecelerationRatio="0.5"
                    Duration="0:0:0.15"
                    Storyboard.TargetName="Thumb"
                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                    To="0.2" />
            </Storyboard>
        </ControlTemplate.Resources>
        <Grid Background="Transparent" x:Name="TemplateRoot">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border
                Background="{DynamicResource Brush.Track.Normal}"
                Grid.ColumnSpan="3"
                Opacity="0"
                x:Name="Background" />
            <RepeatButton
                Command="ScrollBar.LineLeftCommand"
                Content="{StaticResource Geometry.LeftArrow}"
                Grid.Column="0"
                Opacity="0"
                Style="{StaticResource Style.ScrollBar.LineButton}"
                x:Name="LineLeftButton" />
            <RepeatButton
                Command="ScrollBar.LineRightCommand"
                Content="{StaticResource Geometry.RightArrow}"
                Grid.Column="2"
                Opacity="0"
                Style="{StaticResource Style.ScrollBar.LineButton}"
                x:Name="LineRightButton" />
            <Track
                Grid.Column="1"
                Orientation="Horizontal"
                x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton
                        Command="ScrollBar.PageLeftCommand"
                        Style="{StaticResource Style.ScrollBar.PageButton}"
                        x:Name="PageLeftButton" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton
                        Command="ScrollBar.PageRightCommand"
                        Style="{StaticResource Style.ScrollBar.PageButton}"
                        x:Name="IncreaseButton" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb
                        RenderTransformOrigin="0,0.8"
                        Style="{StaticResource Style.ScrollBar.Thumb}"
                        x:Name="Thumb">
                        <Thumb.RenderTransform>
                            <ScaleTransform ScaleY="0.2" />
                        </Thumb.RenderTransform>
                    </Thumb>
                </Track.Thumb>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource Anim.ExpandBar}" />
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource Anim.CollapseBar}" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  template: scroll bar vertical  -->
    <ControlTemplate TargetType="ScrollBar" x:Key="Template.ScrollBar.Vertical">
        <ControlTemplate.Resources>
            <Geometry x:Key="Geometry.UpArrow">M0,4L4,0 8,4</Geometry>
            <Geometry x:Key="Geometry.DownArrow">M0,0 L4,4 8,0</Geometry>
            <Storyboard BeginTime="0:0:0.1" x:Key="Anim.ExpandBar">
                <DoubleAnimation
                    AccelerationRatio="0.75"
                    DecelerationRatio="0.25"
                    Duration="0:0:0.1"
                    Storyboard.TargetName="Background"
                    Storyboard.TargetProperty="Opacity"
                    To="1" />
                <DoubleAnimation
                    AccelerationRatio="0.75"
                    DecelerationRatio="0.25"
                    Duration="0:0:0.1"
                    Storyboard.TargetName="LineUpButton"
                    Storyboard.TargetProperty="Opacity"
                    To="1" />
                <DoubleAnimation
                    AccelerationRatio="0.75"
                    DecelerationRatio="0.25"
                    Duration="0:0:0.1"
                    Storyboard.TargetName="LineDownButton"
                    Storyboard.TargetProperty="Opacity"
                    To="1" />
                <DoubleAnimation
                    DecelerationRatio="0.5"
                    Duration="0:0:0.1"
                    Storyboard.TargetName="Thumb"
                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                    To="1" />
            </Storyboard>
            <Storyboard BeginTime="0:0:2" x:Key="Anim.CollapseBar">
                <DoubleAnimation
                    AccelerationRatio="0.75"
                    DecelerationRatio="0.25"
                    Duration="0:0:0.15"
                    Storyboard.TargetName="Background"
                    Storyboard.TargetProperty="Opacity"
                    To="0" />
                <DoubleAnimation
                    AccelerationRatio="0.75"
                    DecelerationRatio="0.25"
                    Duration="0:0:0.15"
                    Storyboard.TargetName="LineUpButton"
                    Storyboard.TargetProperty="Opacity"
                    To="0" />
                <DoubleAnimation
                    AccelerationRatio="0.75"
                    DecelerationRatio="0.25"
                    Duration="0:0:0.15"
                    Storyboard.TargetName="LineDownButton"
                    Storyboard.TargetProperty="Opacity"
                    To="0" />
                <DoubleAnimation
                    DecelerationRatio="0.5"
                    Duration="0:0:0.15"
                    Storyboard.TargetName="Thumb"
                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                    To="0.2" />
            </Storyboard>
        </ControlTemplate.Resources>
        <Grid Background="Transparent" x:Name="TemplateRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border
                Background="{DynamicResource Brush.Track.Normal}"
                Grid.RowSpan="3"
                Opacity="0"
                x:Name="Background" />
            <RepeatButton
                Command="ScrollBar.LineUpCommand"
                Content="{StaticResource Geometry.UpArrow}"
                Grid.Row="0"
                Opacity="0"
                Style="{StaticResource Style.ScrollBar.LineButton}"
                x:Name="LineUpButton" />
            <RepeatButton
                Command="ScrollBar.LineDownCommand"
                Content="{StaticResource Geometry.DownArrow}"
                Grid.Row="2"
                Opacity="0"
                Style="{StaticResource Style.ScrollBar.LineButton}"
                x:Name="LineDownButton" />
            <Track
                Grid.Row="1"
                IsDirectionReversed="True"
                Orientation="Vertical"
                x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton
                        Command="ScrollBar.PageUpCommand"
                        Style="{StaticResource Style.ScrollBar.PageButton}"
                        x:Name="PageUpButton" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton
                        Command="ScrollBar.PageDownCommand"
                        Style="{StaticResource Style.ScrollBar.PageButton}"
                        x:Name="IncreaseButton" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb
                        RenderTransformOrigin="0.8,0"
                        Style="{StaticResource Style.ScrollBar.Thumb}"
                        x:Name="Thumb">
                        <Thumb.RenderTransform>
                            <ScaleTransform ScaleX="0.2" />
                        </Thumb.RenderTransform>
                    </Thumb>
                </Track.Thumb>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource Anim.ExpandBar}" />
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource Anim.CollapseBar}" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  template: scroll viewer  -->
    <ControlTemplate TargetType="ScrollViewer" x:Key="Template.ScrollViewer">
        <Border
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{DynamicResource Corner.Border0}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Decorator IsEnabled="False" x:Name="ShowBarsRef" />
                <ScrollContentPresenter
                    CanContentScroll="{TemplateBinding CanContentScroll}"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                    Grid.ColumnSpan="2"
                    Grid.RowSpan="2"
                    Margin="{TemplateBinding Padding}" />
                <Rectangle
                    Fill="{DynamicResource Brush.Track.Normal}"
                    Grid.Column="1"
                    Grid.Row="1"
                    IsEnabled="False"
                    Opacity="0"
                    x:Name="Corner" />
                <ScrollBar
                    Grid.Column="0"
                    Grid.Row="1"
                    MaxHeight="{TemplateBinding MinHeight}"
                    Maximum="{TemplateBinding ScrollableWidth}"
                    Minimum="0"
                    Opacity="0"
                    Orientation="Horizontal"
                    Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                    ViewportSize="{TemplateBinding ViewportWidth}"
                    Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                    x:Name="PART_HorizontalScrollBar" />
                <ScrollBar
                    Grid.Column="1"
                    Grid.Row="0"
                    MaxWidth="{TemplateBinding MinWidth}"
                    Maximum="{TemplateBinding ScrollableHeight}"
                    Minimum="0"
                    Opacity="1"
                    Orientation="Vertical"
                    Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                    ViewportSize="{TemplateBinding ViewportHeight}"
                    Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                    x:Name="PART_VerticalScrollBar" />
            </Grid>
        </Border>
        <ControlTemplate.Resources>
            <Storyboard BeginTime="0:0:0.1" x:Key="Anim.ShowBars">
                <DoubleAnimation
                    AccelerationRatio="0.5"
                    DecelerationRatio="0.5"
                    Duration="0:0:0.1"
                    Storyboard.TargetName="PART_HorizontalScrollBar"
                    Storyboard.TargetProperty="Opacity"
                    To="1" />
                <DoubleAnimation
                    AccelerationRatio="0.5"
                    DecelerationRatio="0.5"
                    Duration="0:0:0.1"
                    Storyboard.TargetName="PART_VerticalScrollBar"
                    Storyboard.TargetProperty="Opacity"
                    To="1" />
            </Storyboard>
            <Storyboard BeginTime="0:0:2" x:Key="Anim.HideBars">
                <DoubleAnimation
                    AccelerationRatio="0.75"
                    DecelerationRatio="0.25"
                    Duration="0:0:0.15"
                    Storyboard.TargetName="PART_HorizontalScrollBar"
                    Storyboard.TargetProperty="Opacity"
                    To="0" />
                <DoubleAnimation
                    AccelerationRatio="0.75"
                    DecelerationRatio="0.25"
                    Duration="0:0:0.15"
                    Storyboard.TargetName="PART_VerticalScrollBar"
                    Storyboard.TargetProperty="Opacity"
                    To="0" />
            </Storyboard>
            <Storyboard BeginTime="0:0:0.1" x:Key="Anim.ShowCorner">
                <DoubleAnimation
                    AccelerationRatio="0.75"
                    DecelerationRatio="0.25"
                    Duration="0:0:0.1"
                    Storyboard.TargetName="Corner"
                    Storyboard.TargetProperty="Opacity"
                    To="1" />
            </Storyboard>
            <Storyboard BeginTime="0:0:2" x:Key="Anim.HideCorner">
                <DoubleAnimation
                    AccelerationRatio="0.75"
                    DecelerationRatio="0.25"
                    Duration="0:0:0.15"
                    Storyboard.TargetName="Corner"
                    Storyboard.TargetProperty="Opacity"
                    To="0" />
            </Storyboard>
        </ControlTemplate.Resources>
        <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="IsEnabled" TargetName="ShowBarsRef" Value="True" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="IsEnabled" TargetName="ShowBarsRef" Value="True" />
            </Trigger>
            <Trigger Property="IsEnabled" SourceName="ShowBarsRef" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource Anim.ShowBars}" />
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <!--          <BeginStoryboard Storyboard="{StaticResource Anim.HideBars}" />  -->
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsMouseOver" SourceName="PART_HorizontalScrollBar" Value="True">
                <Setter Property="IsEnabled" TargetName="Corner" Value="True" />
            </Trigger>
            <Trigger Property="IsMouseOver" SourceName="PART_VerticalScrollBar" Value="True">
                <Setter Property="IsEnabled" TargetName="Corner" Value="True" />
            </Trigger>
            <Trigger Property="IsEnabled" SourceName="Corner" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource Anim.ShowCorner}" />
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <!--     <BeginStoryboard Storyboard="{StaticResource Anim.HideCorner}" /> -->
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>


    <!--=== BASE STYLE ===-->

    <!--  base style: scroll bar  -->
    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="ForceCursor" Value="True" />
        <Setter Property="Cursor" Value="Arrow" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="{DynamicResource Size.ScrollBar}" />
                <Setter Property="MinHeight" Value="{DynamicResource Size.ScrollBar}" />
                <Setter Property="Template" Value="{StaticResource Template.ScrollBar.Horizontal}" />
            </Trigger>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="{DynamicResource Size.ScrollBar}" />
                <Setter Property="MinWidth" Value="{DynamicResource Size.ScrollBar}" />
                <Setter Property="Template" Value="{StaticResource Template.ScrollBar.Vertical}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  base style: scroll viewer  -->
    <Style BasedOn="{StaticResource {x:Type ContentControl}}" TargetType="ScrollViewer">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="PanningMode" Value="VerticalFirst" />
        <Setter Property="Template" Value="{StaticResource Template.ScrollViewer}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Style.Focus.Outer.Uniform}" />
    </Style>


</ResourceDictionary>