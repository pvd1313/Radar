<UserControl
    d:DesignHeight="{StaticResource Size.Screen.Height}"
    d:DesignWidth="{StaticResource Size.Screen.Wight}"
    mc:Ignorable="d"
    x:Class="Beast.Radar.UI.GraphyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Beast.Radar.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <noesis:Xaml.Dependencies>
        <noesis:Dependency Source="..\..\..\Texture\Sprite\UI_main\icon_speedometer.png" />
        <noesis:Dependency Source="..\..\..\Texture\Sprite\UI_main\icon_ram.png" />
        <noesis:Dependency Source="..\..\..\Texture\Sprite\UI_main\icon_cassette.png" />
        <noesis:Dependency Source="..\..\..\Texture\Sprite\UI_main\icon_info.png" />
    </noesis:Xaml.Dependencies>


    <UserControl.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Theme\Beast.Radar.UI.Theme.xaml" />
                <ResourceDictionary Source="..\Theme\Beast.Radar.UI.Brushes.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <sys:String x:Key="Path.Icon.Speedometer">Assets/Texture/Sprite/UI_main/icon_speedometer.png</sys:String>
            <sys:String x:Key="Path.Icon.Ram">Assets/Texture/Sprite/UI_main/icon_ram.png</sys:String>
            <sys:String x:Key="Path.Icon.Cassette">Assets/Texture/Sprite/UI_main/icon_cassette.png</sys:String>
            <sys:String x:Key="Path.Icon.Info">Assets/Texture/Sprite/UI_main/icon_info.png</sys:String>

            <Style TargetType="Border" x:Key="Style.Border.Debug">
                <Setter Property="Background" Value="{StaticResource Brush.Panel.Background}" />
                <Setter Property="Opacity" Value="0.7" />
                <Setter Property="CornerRadius" Value="{StaticResource Corner.Popup}" />
            </Style>

            <GridLength x:Key="Size.Offset.Content">5</GridLength>

            <Thickness x:Key="Margin.Button">1.5, 1.5, 1.5, 1.5</Thickness>
            <Thickness x:Key="Margin.Module">1.5, 1.5, 1.5, 1.5</Thickness>
            <Thickness x:Key="Margin.Display">1.5, 1.5, 1.5, 1.5</Thickness>

            <SolidColorBrush x:Key="Brush.Information.Header" Color="{StaticResource Color.Accent1}"/>
        </ResourceDictionary>
    </UserControl.Resources>


    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5"  />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="5"  />
        </Grid.ColumnDefinitions>


        <!--  Top view -->
        <Viewbox Grid.Row ="1" Grid.Column="1" VerticalAlignment="Top" Stretch="Uniform">
            <Grid>
                <Grid.ColumnDefinitions >
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="250" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions >
                    <RowDefinition Height="20*" />
                    <RowDefinition Height="20*" />
                    <RowDefinition Height="20*" />
                    <RowDefinition Height="20*" />
                    <RowDefinition Height="20*" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>

                <!-- Fps -->
                <Grid x:Name="grid_fps"
                      Grid.Row="1" Grid.Column="5"
                      Margin="{StaticResource Margin.Module}"
                      IsHitTestVisible="False">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"  />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="0.2*" />
                        <ColumnDefinition Width="0.7*" />
                        <ColumnDefinition Width="0.7*" />
                        <ColumnDefinition Width="0.7*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions >
                        <RowDefinition Height="{StaticResource Size.Offset.Content}" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="{StaticResource Size.Offset.Content}" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.ColumnSpan="6" Grid.RowSpan="5"
                        Style="{StaticResource Style.Border.Debug}"/>

                    <!--  FPS  -->
                    <TextBlock
                        Grid.Row="1"
                        HorizontalAlignment="Left"
                        Margin="{StaticResource Margin.Left}"
                        Style="{StaticResource Style.Text.Light.Header}"
                        Text="FPS" />

                    <TextBlock
                        Foreground="{StaticResource Brush.Accent.Normal}"
                        Grid.Row="1"
                        Grid.Column="1"
                        HorizontalAlignment="Left"
                        Style="{StaticResource Style.Text.Light.Header}"
                        Text="##"
                        VerticalAlignment="Center"
                        x:Name="text_fps"/>

                    <!--  MS  -->
                    <TextBlock
                        Grid.Row="2"
                        HorizontalAlignment="Left"
                        Margin="{StaticResource Margin.Left}"
                        Style="{StaticResource Style.Text.Light.Header}"
                        Text="MS"
                        VerticalAlignment="Center" />

                    <TextBlock
                        Foreground="{StaticResource Brush.Accent.Normal}"
                        Grid.Column="1"
                        Grid.Row="2"
                        HorizontalAlignment="Left"
                        Style="{StaticResource Style.Text.Light.Header}"
                        Text="##"
                        x:Name="text_ms" />

                    <!--  AVG  -->
                    <TextBlock
                        Grid.Column="3"
                        Grid.Row="1"
                        HorizontalAlignment="Right"
                        Margin="{StaticResource Margin.Right}"
                        Style="{StaticResource Style.Text.Light.Normal}"
                        Text="AVG"
                        VerticalAlignment="Center" />

                    <TextBlock
                        Foreground="{StaticResource Brush.Accent.Normal}"
                        Grid.Column="3"
                        Grid.Row="2"
                        HorizontalAlignment="Right"
                        Margin="{StaticResource Margin.Right}"
                        Style="{StaticResource Style.Text.Light.Normal}"
                        Text="##"
                        VerticalAlignment="Center"
                        x:Name="text_avg" />

                    <!--  1%  -->
                    <TextBlock
                        Grid.Column="4"
                        Grid.Row="1"
                        HorizontalAlignment="Right"
                        Margin="{StaticResource Margin.Right}"
                        Style="{StaticResource Style.Text.Light.Normal}"
                        Text="1%"
                        VerticalAlignment="Center" />

                    <TextBlock
                        Foreground="{StaticResource Brush.Accent.Normal}"
                        Grid.Column="4"
                        Grid.Row="2"
                        HorizontalAlignment="Right"
                        Margin="{StaticResource Margin.Right}"
                        Style="{StaticResource Style.Text.Light.Normal}"
                        Text="##"
                        VerticalAlignment="Center"
                        x:Name="text_one_percent" />

                    <!--  1%  -->
                    <TextBlock
                        Grid.Column="5"
                        Grid.Row="1"
                        HorizontalAlignment="Right"
                        Margin="{StaticResource Margin.Right}"
                        Style="{StaticResource Style.Text.Light.Normal}"
                        Text=".1%"
                        VerticalAlignment="Center" />

                    <TextBlock
                        Foreground="{StaticResource Brush.Accent.Normal}"
                        Grid.Column="5"
                        Grid.Row="2"
                        HorizontalAlignment="Right"
                        Margin="{StaticResource Margin.Right}"
                        Style="{StaticResource Style.Text.Light.Normal}"
                        Text=".##"
                        VerticalAlignment="Center"
                        x:Name="text_zero_one_percent" />

                    <Rectangle x:Name="texture_fps"
                               Grid.ColumnSpan="6" Grid.Row="3"
                               Height="75"
                               Margin="{StaticResource Margin.Display}"/>

                </Grid>

                <!-- Audio -->
                <Grid x:Name="grid_audio"
                      Grid.Row="2" Grid.Column="5"
                      Margin="{StaticResource Margin.Module}"
                      IsHitTestVisible="False">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"  />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="0.2*" />
                        <ColumnDefinition Width="0.7*" />
                        <ColumnDefinition Width="0.7*" />
                        <ColumnDefinition Width="0.7*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions >
                        <RowDefinition Height="{StaticResource Size.Offset.Content}" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="{StaticResource Size.Offset.Content}" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.ColumnSpan="6" Grid.RowSpan="5"
                        Style="{StaticResource Style.Border.Debug}"/>

                    <!--  FPS  -->
                    <TextBlock
                        Grid.Row="1"
                        HorizontalAlignment="Left"
                        Margin="{StaticResource Margin.Left}"
                        Style="{StaticResource Style.Text.Light.Header}"
                        Text="dB" />

                    <TextBlock
                        Foreground="{StaticResource Brush.Accent.Normal}"
                        Grid.Row="1"
                        Grid.Column="1"
                        HorizontalAlignment="Left"
                        Style="{StaticResource Style.Text.Light.Header}"
                        Text="##"
                        VerticalAlignment="Center"
                        x:Name="text_db" />


                    <Rectangle x:Name="texture_audio"
                               Grid.ColumnSpan="6" Grid.Row="3"
                               Height="75"
                               Margin="{StaticResource Margin.Display}"/>

                </Grid>
            </Grid>
        </Viewbox>


        <!-- Bottom view -->
        <Viewbox Grid.Row ="1" Grid.Column="1" VerticalAlignment="Bottom" Stretch="Uniform">

            <Grid Width="{StaticResource Size.Screen.Wight}" HorizontalAlignment="Stretch">

                <Grid.ColumnDefinitions         >
                    <ColumnDefinition Width="50"  />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="250"  />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions >
                    <RowDefinition Height="20*" />
                    <RowDefinition Height="20*" />
                    <RowDefinition Height="20*" />
                    <RowDefinition Height="20*" />
                    <RowDefinition Height="20*" />
                    <RowDefinition Height="20*" />
                </Grid.RowDefinitions>

                <!-- Buttons -->

                <Grid Grid.Row="5" Grid.Column="0"  >

                    <Grid.RowDefinitions >
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                    </Grid.RowDefinitions>

                    <ToggleButton x:Name="button_information"
                                  Grid.Row="0"
                                  Height="{StaticResource Size.Button.Scale.Small}" Width="{StaticResource Size.Button.Scale.Small}"
                                  Style="{StaticResource Style.ToggleButton.Icon}"
                                  Tag="{StaticResource Path.Icon.Info}"
                                  Background="{StaticResource Brush.Panel.Background}"
                                  Foreground="{StaticResource Brush.Element.Light.Normal}"
                                  BorderBrush="{StaticResource Brush.Accent.Normal}"
                                  Margin="{StaticResource Margin.Button}"
                                  />

                    <ToggleButton x:Name="button_fps"
                                  Grid.Row="1"
                                  Height="{StaticResource Size.Button.Scale.Small}" Width="{StaticResource Size.Button.Scale.Small}"
                                  Style="{StaticResource Style.ToggleButton.Icon}"
                                  Tag="{StaticResource Path.Icon.Speedometer}"
                                  Background="{StaticResource Brush.Panel.Background}"
                                  Foreground="{StaticResource Brush.Element.Light.Normal}"
                                  BorderBrush="{StaticResource Brush.Accent.Normal}"
                                  Margin="{StaticResource Margin.Button}"
                                  />


                    <ToggleButton x:Name="button_audio"
                                  Grid.Row="2"
                                  Height="{StaticResource Size.Button.Scale.Small}" Width="{StaticResource Size.Button.Scale.Small}"
                                  Style="{StaticResource Style.ToggleButton.Icon}"
                                  Tag="{StaticResource Path.Icon.Cassette}"
                                  Background="{StaticResource Brush.Panel.Background}"
                                  Foreground="{StaticResource Brush.Element.Light.Normal}"
                                  BorderBrush="{StaticResource Brush.Accent.Normal}"
                                  Margin="{StaticResource Margin.Button}"
                                  />


                    <ToggleButton x:Name="button_ram"
                                  Grid.Row="3"
                                  Height="{StaticResource Size.Button.Scale.Small}" Width="{StaticResource Size.Button.Scale.Small}"
                                  Style="{StaticResource Style.ToggleButton.Icon}"
                                  Tag="{StaticResource Path.Icon.Ram}"
                                  Background="{StaticResource Brush.Panel.Background}"
                                  Foreground="{StaticResource Brush.Element.Light.Normal}"
                                  BorderBrush="{StaticResource Brush.Accent.Normal}"
                                  Margin="{StaticResource Margin.Button}"
                                  />

                </Grid>

                <!-- Information -->
                <Grid x:Name="grid_information"
                      HorizontalAlignment="Left"
                      IsHitTestVisible="False"
                      Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="4">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="{StaticResource Size.Offset.Content}" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="{StaticResource Size.Offset.Content}" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Size.Offset.Content}" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="{StaticResource Size.Offset.Content}" />
                    </Grid.ColumnDefinitions>


                    <Border
                        Grid.RowSpan="10"
                        Grid.ColumnSpan="3"

                        Margin="-2"
                        Style="{StaticResource Style.Border.Debug}"  IsEnabled="False" />


                    <TextBlock x:Name="text_graphicsDeviceVersion"
                               Foreground="White"
                               Grid.Row="1" Grid.Column="1"
                               HorizontalAlignment="Left"
                               Style="{StaticResource Style.Text.Light.Normal}"
                               Text="text_graphicsDeviceVersion" />

                    <TextBlock x:Name="text_processorType"
                               Foreground="White"
                               Grid.Row="2" Grid.Column="1"
                               HorizontalAlignment="Left"
                               Style="{StaticResource Style.Text.Light.Normal}"
                               Text="text_processorType"
                               VerticalAlignment="Center" />

                    <TextBlock x:Name="text_operatingSystem"
                               Foreground="White"
                               Grid.Row="3" Grid.Column="1"
                               HorizontalAlignment="Left"
                               Style="{StaticResource Style.Text.Light.Normal}"
                               Text="text_operatingSystem"
                               VerticalAlignment="Center" />

                    <TextBlock x:Name="text_systemMemory"
                               Foreground="White"
                               Grid.Row="4" Grid.Column="1"
                               HorizontalAlignment="Left"
                               Style="{StaticResource Style.Text.Light.Normal}"
                               Text="text_systemMemory"
                               VerticalAlignment="Center" />

                    <TextBlock x:Name="text_graphicsDeviceName"
                               Foreground="White"
                               Grid.Row="5" Grid.Column="1"
                               HorizontalAlignment="Left"
                               Style="{StaticResource Style.Text.Light.Normal}"
                               Text="text_graphicsDeviceName"
                               VerticalAlignment="Center" />

                    <TextBlock x:Name="text_graphicsMemorySize"
                               Foreground="White"
                               Grid.Row="6" Grid.Column="1"
                               HorizontalAlignment="Left"
                               Style="{StaticResource Style.Text.Light.Normal}"
                               Text="text_graphicsMemorySize"
                               VerticalAlignment="Center" />

                    <TextBlock x:Name="text_screenResolution"
                               Foreground="White"
                               Grid.Row="7" Grid.Column="1"
                               HorizontalAlignment="Left"
                               Style="{StaticResource Style.Text.Light.Normal}"
                               Text="text_screenResolution"
                               VerticalAlignment="Center" />

                    <TextBlock x:Name="text_gameWindowResolution"
                               Foreground="White"
                               Grid.Row="8" Grid.Column="1"
                               HorizontalAlignment="Left"
                               Style="{StaticResource Style.Text.Light.Normal}"
                               Text="text_gameWindowResolution"
                               VerticalAlignment="Center" />

                </Grid>
            </Grid>
        </Viewbox>

    </Grid>
</UserControl>
