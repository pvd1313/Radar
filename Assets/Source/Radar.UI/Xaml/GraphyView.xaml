<UserControl x:Class="Beast.Radar.UI.GraphyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
             xmlns:local="clr-namespace:Beast.Radar.UI"
             mc:Ignorable="d"
             IsTabStop="False"
             d:DesignHeight="1092.486" d:DesignWidth="1798.923">


    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Theme\Beast.Radar.UI.Theme.xaml" />
                <ResourceDictionary Source="..\Theme\Beast.Radar.UI.Brushes.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Canvas Height="1092.486" Width="1798.923">

            <Grid
                RenderTransformOrigin="0.0,0.0"
                Width="330"
                Height="172"
                Canvas.Right="50"
                Canvas.Top="50"
                HorizontalAlignment="Left"
                VerticalAlignment="Top" >

                <Border Style="{StaticResource Style.Border.Dark.Normal}"/>

                <TextBlock

                    Height="30"
                    Width="33"
                    Text="FPS"
                    Style="{StaticResource Style.Text.Light.Header}" />

            </Grid>
        </Canvas>
    </Viewbox>
</UserControl>
