<UserControl
    d:DesignHeight="{StaticResource Size.Screen.Height}"
    d:DesignWidth="{StaticResource Size.Screen.Wight}"
    mc:Ignorable="d"
    x:Class="Beast.Radar.UI.GraphyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Beast.Radar.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Theme\Beast.Radar.UI.Theme.xaml" />
                <ResourceDictionary Source="..\Theme\Beast.Radar.UI.Brushes.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="Border" x:Key="Style.Border.Debug">
                <Setter Property="Background" Value="{StaticResource Brush.Panel.Background}" />
                <Setter Property="Opacity" Value="0.7" />
                <Setter Property="CornerRadius" Value="{StaticResource Corner.Popup}" />
            </Style>

            <GridLength x:Key="Size.Offset.Content">3</GridLength>

            <Thickness x:Key="Margin.Button">1.5, 1.5, 1.5, 1.5</Thickness>
            <Thickness x:Key="Margin.Module">1.5, 1.5, 1.5, 1.5</Thickness>
            <Thickness x:Key="Margin.Display">2, 2, 2, 2</Thickness>

            <SolidColorBrush x:Key="Brush.Text.Main" Color="White"/>
            <SolidColorBrush x:Key="Brush.Text.Accent" Color="{StaticResource Color.Accent1}"/>
            <SolidColorBrush x:Key="Brush.Information.Header" Color="{StaticResource Color.Accent1}"/>

            <sys:Double x:Key="Size.Display.Height">60</sys:Double>
        </ResourceDictionary>
    </UserControl.Resources>


    <Grid x:Name="grid_window">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" x:Name="grid_row_top"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0"/>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="0"/>
        </Grid.ColumnDefinitions>

        <!--  Top view -->
        <Viewbox Grid.Row ="1" Grid.Column="1" VerticalAlignment="Top" Stretch="Uniform">
            <Grid>
                <Grid.ColumnDefinitions >
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions >
                    <RowDefinition Height="20*" />
                    <RowDefinition Height="20*" />
                    <RowDefinition Height="20*" />
                    <RowDefinition Height="20*" />
                    <RowDefinition Height="20*" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>

                <!-- Buttons -->
                <Grid Grid.Row="1" Grid.Column="4"  >

                    <Grid.ColumnDefinitions >
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <ToggleButton x:Name="button_information"
                                  Grid.Column="0"
                                  Height="{StaticResource Size.Button.Scale.Small}"  Width="{StaticResource Size.Button.Scale.Medium}"
                                  Style="{StaticResource Style.ToggleButton.Text}"
                                  Tag="OS"
                                  Foreground="{StaticResource Brush.Element.Light.Normal}"
                                  Background="{StaticResource Brush.Panel.Background}"
                                  BorderBrush="{StaticResource Brush.Accent.Normal}"
                                  Margin="{StaticResource Margin.Button}"
                                  />

                    <ToggleButton x:Name="button_fps"
                                  Grid.Column="1"
                                  Height="{StaticResource Size.Button.Scale.Small}" Width="{StaticResource Size.Button.Scale.Medium}"
                                  Style="{StaticResource Style.ToggleButton.Text}"
                                  Tag="FPS"
                                  Background="{StaticResource Brush.Panel.Background}"
                                  Foreground="{StaticResource Brush.Element.Light.Normal}"
                                  BorderBrush="{StaticResource Brush.Accent.Normal}"
                                  Margin="{StaticResource Margin.Button}"
                                  />


                    <ToggleButton x:Name="button_audio"
                                  Grid.Column="2"
                                  Height="{StaticResource Size.Button.Scale.Small}" Width="{StaticResource Size.Button.Scale.Medium}"
                                  Style="{StaticResource Style.ToggleButton.Text}"
                                  Tag="AUX"
                                  Background="{StaticResource Brush.Panel.Background}"
                                  Foreground="{StaticResource Brush.Element.Light.Normal}"
                                  BorderBrush="{StaticResource Brush.Accent.Normal}"
                                  Margin="{StaticResource Margin.Button}"
                                  />


                    <ToggleButton x:Name="button_ram"
                                  Grid.Column="3"
                                  Height="{StaticResource Size.Button.Scale.Small}" Width="{StaticResource Size.Button.Scale.Medium}"
                                  Style="{StaticResource Style.ToggleButton.Text}"
                                  Tag="RAM"
                                  Background="{StaticResource Brush.Panel.Background}"
                                  Foreground="{StaticResource Brush.Element.Light.Normal}"
                                  BorderBrush="{StaticResource Brush.Accent.Normal}"
                                  Margin="{StaticResource Margin.Button}"
                                  />

                </Grid>

                <!-- Grid Fps -->
                <Grid x:Name="grid_fps" Grid.Row="2" Grid.Column="4"
                      Margin="{StaticResource Margin.Module}"
                      IsHitTestVisible="False">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Size.Offset.Content}" />
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="0.2*" />
                        <ColumnDefinition Width="0.7*" />
                        <ColumnDefinition Width="0.7*" />
                        <ColumnDefinition Width="0.7*" />
                        <ColumnDefinition Width="{StaticResource Size.Offset.Content}" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions >
                        <RowDefinition Height="{StaticResource Size.Offset.Content}" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="{StaticResource Size.Offset.Content}" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.ColumnSpan="8" Grid.RowSpan="5"
                        Style="{StaticResource Style.Border.Debug}"/>

                    <!--  FPS  -->
                    <TextBlock
                        Grid.Row="1" Grid.Column="1"
                        HorizontalAlignment="Left"
                        Margin="{StaticResource Margin.Left}"
                        Style="{StaticResource Style.Text.Light.Header}"
                        Foreground="{StaticResource Brush.Text.Main}"
                        Text="FPS" />

                    <TextBlock
                        Foreground="{StaticResource Brush.Text.Accent}"
                        Grid.Row="1" Grid.Column="2"
                        HorizontalAlignment="Left"
                        Style="{StaticResource Style.Text.Light.Header}"
                        Text="##"
                        VerticalAlignment="Center"
                        x:Name="text_fps"/>

                    <!--  MS  -->
                    <TextBlock
                        Grid.Row="2" Grid.Column="1"
                        HorizontalAlignment="Left"
                        Margin="{StaticResource Margin.Left}"
                        Style="{StaticResource Style.Text.Light.Header}"
                        Foreground="{StaticResource Brush.Text.Main}"
                        Text="MS"
                        VerticalAlignment="Center" />

                    <TextBlock
                        Foreground="{StaticResource Brush.Text.Accent}"
                        Grid.Column="2" Grid.Row="2"
                        HorizontalAlignment="Left"
                        Style="{StaticResource Style.Text.Light.Header}"
                        Text="##"
                        x:Name="text_ms" />

                    <!--  AVG  -->
                    <TextBlock
                        Grid.Column="4" Grid.Row="1"
                        HorizontalAlignment="Right"
                        Margin="{StaticResource Margin.Right}"
                        Style="{StaticResource Style.Text.Light.Normal}"
                        Foreground="{StaticResource Brush.Text.Main}"
                        Text="AVG"
                        VerticalAlignment="Center" />

                    <TextBlock
                        Foreground="{StaticResource Brush.Text.Accent}"
                        Grid.Column="4" Grid.Row="2"
                        HorizontalAlignment="Right"
                        Margin="{StaticResource Margin.Right}"
                        Style="{StaticResource Style.Text.Light.Normal}"
                        Text="##"
                        VerticalAlignment="Center"
                        x:Name="text_avg" />

                    <!--  1%  -->
                    <TextBlock
                        Grid.Column="5" Grid.Row="1"
                        HorizontalAlignment="Right"
                        Margin="{StaticResource Margin.Right}"
                        Style="{StaticResource Style.Text.Light.Normal}"
                        Foreground="{StaticResource Brush.Text.Main}"
                        Text="1%"
                        VerticalAlignment="Center" />

                    <TextBlock
                        Foreground="{StaticResource Brush.Text.Accent}"
                        Grid.Column="5"
                        Grid.Row="2"
                        HorizontalAlignment="Right"
                        Margin="{StaticResource Margin.Right}"
                        Style="{StaticResource Style.Text.Light.Normal}"
                        Text="##"
                        VerticalAlignment="Center"
                        x:Name="text_one_percent" />

                    <!--  1%  -->
                    <TextBlock
                        Foreground="{StaticResource Brush.Text.Main}"
                        Grid.Column="6"
                        Grid.Row="1"
                        HorizontalAlignment="Right"
                        Style="{StaticResource Style.Text.Light.Normal}"
                        Text=".1%"
                        VerticalAlignment="Center" />

                    <TextBlock
                        Foreground="{StaticResource Brush.Text.Accent}"
                        Grid.Column="6"
                        Grid.Row="2"
                        HorizontalAlignment="Right"
                        Margin="{StaticResource Margin.Right}"
                        Style="{StaticResource Style.Text.Light.Normal}"
                        Text=".##"
                        VerticalAlignment="Center"
                        x:Name="text_zero_one_percent" />

                    <Rectangle x:Name="texture_fps"
                               Grid.ColumnSpan="6" Grid.Column="1" Grid.Row="3"
                               Height="{StaticResource Size.Display.Height}"
                               Margin="{StaticResource Margin.Display}"/>

                </Grid>

                <!-- Grid Audio -->
                <Grid x:Name="grid_audio" Grid.Row="3" Grid.Column="4"
                      Margin="{StaticResource Margin.Module}"
                      IsHitTestVisible="False">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Size.Offset.Content}"  />
                        <ColumnDefinition Width="0.2*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="{StaticResource Size.Offset.Content}"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions >
                        <RowDefinition Height="{StaticResource Size.Offset.Content}" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="3*" />

                        <RowDefinition Height="{StaticResource Size.Offset.Content}" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.ColumnSpan="6" Grid.RowSpan="5"
                        Style="{StaticResource Style.Border.Debug}"/>

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Style="{StaticResource Style.Text.Light.Header}"
                        Foreground="{StaticResource Brush.Text.Main}"
                        Text="DB" />

                    <TextBlock
                        Foreground="{StaticResource Brush.Text.Accent}"
                        Grid.Row="1"
                        Grid.Column="2"
                        HorizontalAlignment="Left"
                        Style="{StaticResource Style.Text.Light.Header}"
                        Text="##"
                        VerticalAlignment="Center"
                        x:Name="text_db" />

                    <Rectangle x:Name="texture_audio_previous"
                               Opacity="0.5"
                               Grid.Column="1"  Grid.ColumnSpan="2" Grid.Row="2"
                               Height="{StaticResource Size.Display.Height}"
                               Margin="{StaticResource Margin.Display}"/>

                    <Rectangle x:Name="texture_audio_current"
                               Grid.Column="1"  Grid.ColumnSpan="2" Grid.Row="2"
                               Height="{StaticResource Size.Display.Height}"
                               Margin="{StaticResource Margin.Display}"/>

                </Grid>

                <!-- Grid Ram -->
                <Grid x:Name="grid_ram"
                      Grid.Row="4" Grid.Column="4"
                      Margin="{StaticResource Margin.Module}"
                      IsHitTestVisible="False">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Size.Offset.Content}" />
                        <ColumnDefinition Width="0.75*"  />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="0.3*" />
                        <ColumnDefinition Width="{StaticResource Size.Offset.Content}" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions >
                        <RowDefinition Height="{StaticResource Size.Offset.Content}" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="3*" />
                        <RowDefinition Height="{StaticResource Size.Offset.Content}" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.ColumnSpan="5" Grid.RowSpan="5"
                        Style="{StaticResource Style.Border.Debug}"/>

                    <!-- reserved -->
                    <TextBlock
                        Grid.Row="1" Grid.Column="1"
                        HorizontalAlignment="Right"
                        Foreground="{StaticResource Brush.Text.Main}"
                        Style="{StaticResource Style.Text.Light.Normal}"
                        Text="reserved" />

                    <TextBlock
                        Foreground="{StaticResource Brush.Text.Accent}"
                        Grid.Row="1" Grid.Column="2"
                        HorizontalAlignment="Right"
                        Style="{StaticResource Style.Text.Light.Normal}"
                        Text="######"
                        VerticalAlignment="Center"
                        x:Name="text_reserved" />

                    <TextBlock
                        Grid.Row="1" Grid.Column="3"
                        HorizontalAlignment="Center"
                        Foreground="{StaticResource Brush.Text.Main}"
                        Style="{StaticResource Style.Text.Light.Normal}"
                        Text="MB" />

                    <!-- allocated -->
                    <TextBlock
                        Grid.Row="2" Grid.Column="1"
                        HorizontalAlignment="Right"
                        Foreground="{StaticResource Brush.Text.Main}"
                        Style="{StaticResource Style.Text.Light.Normal}"
                        Text="allocated" />

                    <TextBlock
                        Foreground="{StaticResource Brush.Text.Accent}"
                        Grid.Row="2" Grid.Column="2"
                        HorizontalAlignment="Right"
                        Style="{StaticResource Style.Text.Light.Normal}"
                        Text="######"
                        VerticalAlignment="Center"
                        x:Name="text_allocated" />

                    <TextBlock
                        Grid.Row="2" Grid.Column="3"
                        HorizontalAlignment="Center"
                        Foreground="{StaticResource Brush.Text.Main}"
                        Style="{StaticResource Style.Text.Light.Normal}"
                        Text="MB" />



                    <!-- mono -->
                    <TextBlock
                        Grid.Row="3" Grid.Column="1"
                        HorizontalAlignment="Right"
                        Foreground="{StaticResource Brush.Text.Main}"
                        Style="{StaticResource Style.Text.Light.Normal}"
                        Text="mono" />

                    <TextBlock
                        Foreground="{StaticResource Brush.Text.Accent}"
                        Grid.Row="3" Grid.Column="2"
                        HorizontalAlignment="Right"
                        Style="{StaticResource Style.Text.Light.Normal}"
                        Text="######"
                        VerticalAlignment="Center"
                        x:Name="text_mono" />

                    <TextBlock
                        Grid.Row="3" Grid.Column="3"
                        HorizontalAlignment="Center"
                        Foreground="{StaticResource Brush.Text.Main}"
                        Style="{StaticResource Style.Text.Light.Normal}"
                        Text="MB" />


                    <Rectangle x:Name="texture_reserved"
                               Opacity="0.5"
                               Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="4"
                               Height="{StaticResource Size.Display.Height}"
                               Margin="{StaticResource Margin.Display}"/>

                    <Rectangle x:Name="texture_allocated"
                               Opacity="0.5"
                               Grid.Column="1" Grid.ColumnSpan="3"  Grid.Row="4"
                               Height="{StaticResource Size.Display.Height}"
                               Margin="{StaticResource Margin.Display}"/>

                    <Rectangle x:Name="texture_mono"
                               Opacity="0.5"
                               Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="4"
                               Height="{StaticResource Size.Display.Height}"
                               Margin="{StaticResource Margin.Display}"/>


                </Grid>

            </Grid>
        </Viewbox>


        <!-- Bottom view -->
        <Viewbox Grid.Row ="1" Grid.Column="1" VerticalAlignment="Bottom" Stretch="Uniform">

            <Grid  HorizontalAlignment="Stretch">

                <Grid.ColumnDefinitions         >
                    <ColumnDefinition Width="50"  />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="250"  />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions >
                    <RowDefinition Height="20*" />
                    <RowDefinition Height="20*" />
                    <RowDefinition Height="20*" />
                    <RowDefinition Height="20*" />

                </Grid.RowDefinitions>


                <!-- Information -->
                <Grid x:Name="grid_information"
                      HorizontalAlignment="Left"
                      IsHitTestVisible="False"
                      Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="{StaticResource Size.Offset.Content}" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="{StaticResource Size.Offset.Content}" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Size.Offset.Content}" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="{StaticResource Size.Offset.Content}" />
                    </Grid.ColumnDefinitions>


                    <Border
                        Grid.RowSpan="10"
                        Grid.ColumnSpan="3"

                        Margin="-2"
                        Style="{StaticResource Style.Border.Debug}"  IsEnabled="False" />


                    <TextBlock x:Name="text_graphicsDeviceVersion"
                               Foreground="White"
                               Grid.Row="1" Grid.Column="1"
                               HorizontalAlignment="Left"
                               Style="{StaticResource Style.Text.Light.Normal}"
                               Text="text_graphicsDeviceVersion" />

                    <TextBlock x:Name="text_processorType"
                               Foreground="White"
                               Grid.Row="2" Grid.Column="1"
                               HorizontalAlignment="Left"
                               Style="{StaticResource Style.Text.Light.Normal}"
                               Text="text_processorType"
                               VerticalAlignment="Center" />

                    <TextBlock x:Name="text_operatingSystem"
                               Foreground="White"
                               Grid.Row="3" Grid.Column="1"
                               HorizontalAlignment="Left"
                               Style="{StaticResource Style.Text.Light.Normal}"
                               Text="text_operatingSystem"
                               VerticalAlignment="Center" />

                    <TextBlock x:Name="text_systemMemory"
                               Foreground="White"
                               Grid.Row="4" Grid.Column="1"
                               HorizontalAlignment="Left"
                               Style="{StaticResource Style.Text.Light.Normal}"
                               Text="text_systemMemory"
                               VerticalAlignment="Center" />

                    <TextBlock x:Name="text_graphicsDeviceName"
                               Foreground="White"
                               Grid.Row="5" Grid.Column="1"
                               HorizontalAlignment="Left"
                               Style="{StaticResource Style.Text.Light.Normal}"
                               Text="text_graphicsDeviceName"
                               VerticalAlignment="Center" />

                    <TextBlock x:Name="text_graphicsMemorySize"
                               Foreground="White"
                               Grid.Row="6" Grid.Column="1"
                               HorizontalAlignment="Left"
                               Style="{StaticResource Style.Text.Light.Normal}"
                               Text="text_graphicsMemorySize"
                               VerticalAlignment="Center" />

                    <TextBlock x:Name="text_screenResolution"
                               Foreground="White"
                               Grid.Row="7" Grid.Column="1"
                               HorizontalAlignment="Left"
                               Style="{StaticResource Style.Text.Light.Normal}"
                               Text="text_screenResolution"
                               VerticalAlignment="Center" />

                    <TextBlock x:Name="text_gameWindowResolution"
                               Foreground="White"
                               Grid.Row="8" Grid.Column="1"
                               HorizontalAlignment="Left"
                               Style="{StaticResource Style.Text.Light.Normal}"
                               Text="text_gameWindowResolution"
                               VerticalAlignment="Center" />

                </Grid>
            </Grid>
        </Viewbox>

    </Grid>
</UserControl>
