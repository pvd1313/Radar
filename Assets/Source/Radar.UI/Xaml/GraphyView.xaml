<UserControl
    IsHitTestVisible="False"
    d:DesignHeight="{StaticResource Size.Screen.Height}"
    d:DesignWidth="{StaticResource Size.Screen.Wight}"
    mc:Ignorable="d"
    x:Class="Beast.Radar.UI.GraphyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Beast.Radar.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Theme\Beast.Radar.UI.Theme.xaml" />
                <ResourceDictionary Source="..\Theme\Beast.Radar.UI.Brushes.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="Border" x:Key="Style.Border.Debug">
                <Setter Property="Background" Value="{StaticResource Brush.Panel.Background}" />
                <Setter Property="Opacity" Value="0.7" />
                <Setter Property="CornerRadius" Value="{StaticResource Corner.Popup}" />
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid >

        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5"  />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="5"  />
        </Grid.ColumnDefinitions>


        <!--  Top gtid -->
        <Viewbox Grid.Row ="1" Grid.Column="1" VerticalAlignment="Top" Stretch="Uniform">
            <Grid>
                <Grid.ColumnDefinitions >
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="250" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions >
                    <RowDefinition Height="20*" />
                    <RowDefinition Height="20*" />
                    <RowDefinition Height="20*" />
                    <RowDefinition Height="20*" />
                    <RowDefinition Height="20*" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>

                <!-- Fps -->

                <Grid x:Name="grid_fps"
                      Grid.Row="0"
                      Grid.Column="5">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"  />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="0.2*" />
                        <ColumnDefinition Width="0.7*" />
                        <ColumnDefinition Width="0.7*" />
                        <ColumnDefinition Width="0.7*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions >
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="2*" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.ColumnSpan="6"
                        Grid.RowSpan="4"
                        IsHitTestVisible="False"
                        Style="{StaticResource Style.Border.Debug}"  IsEnabled="False"  />

                    <!--  FPS  -->
                    <TextBlock
                        HorizontalAlignment="Left"
                        Margin="{StaticResource Margin.Left}"
                        Style="{StaticResource Style.Text.Light.Header}"
                        Text="FPS" />

                    <TextBlock
                        Foreground="{StaticResource Brush.Accent.Normal}"
                        Grid.Column="1"
                        HorizontalAlignment="Left"
                        Style="{StaticResource Style.Text.Light.Header}"
                        Text="##"
                        VerticalAlignment="Center"
                        x:Name="text_fps" />

                    <!--  MS  -->
                    <TextBlock
                        Grid.Row="1"
                        HorizontalAlignment="Left"
                        Margin="{StaticResource Margin.Left}"
                        Style="{StaticResource Style.Text.Light.Header}"
                        Text="MS"
                        VerticalAlignment="Center" />

                    <TextBlock
                        Foreground="{StaticResource Brush.Accent.Normal}"
                        Grid.Column="1"
                        Grid.Row="1"
                        HorizontalAlignment="Left"
                        Style="{StaticResource Style.Text.Light.Header}"
                        Text="##"
                        x:Name="text_ms" />

                    <!--  AVG  -->
                    <TextBlock
                        Grid.Column="3"
                        HorizontalAlignment="Right"
                        Margin="{StaticResource Margin.Right}"
                        Style="{StaticResource Style.Text.Light.Normal}"
                        Text="AVG"
                        VerticalAlignment="Center" />

                    <TextBlock
                        Foreground="{StaticResource Brush.Accent.Normal}"
                        Grid.Column="3"
                        Grid.Row="1"
                        HorizontalAlignment="Right"
                        Margin="{StaticResource Margin.Right}"
                        Style="{StaticResource Style.Text.Light.Normal}"
                        Text="##"
                        VerticalAlignment="Center"
                        x:Name="text_avg" />

                    <!--  1%  -->
                    <TextBlock
                        Grid.Column="4"
                        HorizontalAlignment="Right"
                        Margin="{StaticResource Margin.Right}"
                        Style="{StaticResource Style.Text.Light.Normal}"
                        Text="1%"
                        VerticalAlignment="Center" />

                    <TextBlock
                        Foreground="{StaticResource Brush.Accent.Normal}"
                        Grid.Column="4"
                        Grid.Row="1"
                        HorizontalAlignment="Right"
                        Margin="{StaticResource Margin.Right}"
                        Style="{StaticResource Style.Text.Light.Normal}"
                        Text="##"
                        VerticalAlignment="Center"
                        x:Name="text_one_percent" />

                    <!--  1%  -->
                    <TextBlock
                        Grid.Column="5"
                        HorizontalAlignment="Right"
                        Margin="{StaticResource Margin.Right}"
                        Style="{StaticResource Style.Text.Light.Normal}"
                        Text=".1%"
                        VerticalAlignment="Center" />

                    <TextBlock
                        Foreground="{StaticResource Brush.Accent.Normal}"
                        Grid.Column="5"
                        Grid.Row="1"
                        HorizontalAlignment="Right"
                        Margin="{StaticResource Margin.Right}"
                        Style="{StaticResource Style.Text.Light.Normal}"
                        Text=".##"
                        VerticalAlignment="Center"
                        x:Name="text_zero_one_percent" />

                    <Rectangle x:Name="texture_fps"
                               Grid.ColumnSpan="6" Grid.Row="3" Height="75" Margin="15"/>

                </Grid>
            </Grid>
        </Viewbox>


        <!-- Bottom gtid -->
        <Viewbox Grid.Row ="1" Grid.Column="1" VerticalAlignment="Bottom" Stretch="Uniform">
            <Grid Width="{StaticResource Size.Screen.Wight}" HorizontalAlignment="Stretch"  >

                <Grid.ColumnDefinitions         >
                    <ColumnDefinition Width="250"  />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="250"  />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions >
                    <RowDefinition Height="20*" />
                    <RowDefinition Height="20*" />
                    <RowDefinition Height="20*" />
                    <RowDefinition Height="20*" />
                    <RowDefinition Height="20*" />
                    <RowDefinition Height="20*" />
                </Grid.RowDefinitions>

                <!-- ADVANCED -->
                <Grid x:Name="grid_advanced"  HorizontalAlignment="Left"
                      Grid.Row="5"
                      Grid.Column="0" Grid.ColumnSpan="3">

                    <Grid.RowDefinitions >
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.RowSpan="8"
                        IsHitTestVisible="False"
                        Margin="-2"
                        Style="{StaticResource Style.Border.Debug}"  IsEnabled="False"  />

                    <TextBlock x:Name="text_graphicsDeviceVersion"
                               Foreground="White"
                               HorizontalAlignment="Left"
                               Margin="{StaticResource Margin.Left}"
                               Style="{StaticResource Style.Text.Light.Normal}"
                               Text="text_graphicsDeviceVersion" />

                    <TextBlock x:Name="text_processorType"
                               Foreground="White"
                               Grid.Row="1"
                               HorizontalAlignment="Left"
                               Margin="{StaticResource Margin.Left}"
                               Style="{StaticResource Style.Text.Light.Normal}"
                               Text="text_processorType"
                               VerticalAlignment="Center" />

                    <TextBlock x:Name="text_operatingSystem"
                               Foreground="White"
                               Grid.Row="2"
                               HorizontalAlignment="Left"
                               Margin="{StaticResource Margin.Left}"
                               Style="{StaticResource Style.Text.Light.Normal}"
                               Text="text_operatingSystem"
                               VerticalAlignment="Center" />

                    <TextBlock x:Name="text_systemMemory"
                               Foreground="White"
                               Grid.Row="3"
                               HorizontalAlignment="Left"
                               Margin="{StaticResource Margin.Left}"
                               Style="{StaticResource Style.Text.Light.Normal}"
                               Text="text_systemMemory"
                               VerticalAlignment="Center" />

                    <TextBlock x:Name="text_graphicsDeviceName"
                               Foreground="White"
                               Grid.Row="4"
                               HorizontalAlignment="Left"
                               Margin="{StaticResource Margin.Left}"
                               Style="{StaticResource Style.Text.Light.Normal}"
                               Text="text_graphicsDeviceName"
                               VerticalAlignment="Center" />

                    <TextBlock x:Name="text_graphicsMemorySize"
                               Foreground="White"
                               Grid.Row="5"
                               HorizontalAlignment="Left"
                               Margin="{StaticResource Margin.Left}"
                               Style="{StaticResource Style.Text.Light.Normal}"
                               Text="text_graphicsMemorySize"
                               VerticalAlignment="Center" />

                    <TextBlock x:Name="text_screenResolution"
                               Foreground="White"
                               Grid.Row="6"
                               HorizontalAlignment="Left"
                               Margin="{StaticResource Margin.Left}"
                               Style="{StaticResource Style.Text.Light.Normal}"
                               Text="text_screenResolution"
                               VerticalAlignment="Center" />

                    <TextBlock x:Name="text_gameWindowResolution"
                               Foreground="White"
                               Grid.Row="7"
                               HorizontalAlignment="Left"
                               Margin="{StaticResource Margin.Left}"
                               Style="{StaticResource Style.Text.Light.Normal}"
                               Text="text_gameWindowResolution"
                               VerticalAlignment="Center" />

                </Grid>
            </Grid>
        </Viewbox>

    </Grid>
</UserControl>
