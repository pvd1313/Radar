<UserControl
    Background="{StaticResource Brush.Panel.Dark.Normal}"
    d:DesignHeight="480"
    d:DesignWidth="960"
    mc:Ignorable="d"
    x:Class="Beast.Radar.UI.MapGenerationWindowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Theme\Beast.Radar.UI.Theme.xaml" />
                <ResourceDictionary Source="..\Theme\Beast.Radar.UI.Brushes.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Viewbox Stretch="Uniform">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="390" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="470" />
                <ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>


            <!-- Texture -->
            <Rectangle x:Name="rect_texture"
                       Grid.Column="1"
                       Grid.Row="1"
                       Height="300"
                       Width="300"  />


            <Button x:Name="button_close"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Margin="5"
                    Grid.Column="4"
                    Style="{StaticResource Style.Button.Close}"/>

            <Viewbox
                Grid.Column="2"
                Grid.Row="1"
                Stretch="Uniform"
                Width="420">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="70" />
                        <RowDefinition Height="70" />
                        <RowDefinition Height="70" />
                        <RowDefinition Height="70" />
                        <RowDefinition Height="70" />
                        <RowDefinition Height="70" />
                    </Grid.RowDefinitions>

                    <!--  Seed  -->
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="1.2*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            HorizontalAlignment="Center"
                            Margin="5"
                            Style="{StaticResource Style.Text.Light.Header}"
                            Text="SEED" />

                        <TextBlock
                            Foreground="{StaticResource Brush.Accent.Normal}"
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            Margin="5"
                            Style="{StaticResource Style.Text.Light.Header}"
                            Text="BLACK FOREST"
                            x:Name="text_seed" />

                        <Button
                            Grid.Row="1"
                            Height="30"
                            HorizontalAlignment="Right"
                            Margin="0,0,10,0"
                            Style="{StaticResource Style.Button.Triangle}"
                            Tag="90"
                            Width="30"
                            x:Name="button_next_seed" />

                        <Button
                            Grid.Row="1"
                            Height="30"
                            HorizontalAlignment="Left"
                            Margin="0,0,10,0"
                            Style="{StaticResource Style.Button.Triangle}"
                            Tag="270"
                            Width="30"
                            x:Name="button_previous_seed" />

                    </Grid>

                    <!--  Map size  -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Grid.ColumnSpan="4"
                            HorizontalAlignment="Center"
                            Margin="5"
                            Style="{StaticResource Style.Text.Light.Header}"
                            Text="MAP SIZE" />

                        <RadioButton
                            Content="x512"
                            Grid.Row="1"
                            Margin="4"
                            Style="{StaticResource Style.RadioButton.Base}"
                            x:Name="radio_button_512" />

                        <RadioButton
                            Content="x1024"
                            Grid.Column="1"
                            Grid.Row="1"
                            Margin="4"
                            Style="{StaticResource Style.RadioButton.Base}"
                            x:Name="radio_button_1024" />

                        <RadioButton
                            Content="x2048"
                            Grid.Column="2"
                            Grid.Row="1"
                            Margin="4"
                            Style="{StaticResource Style.RadioButton.Base}"
                            x:Name="radio_button_2048" />

                        <RadioButton
                            Content="x4096"
                            Grid.Column="3"
                            Grid.Row="1"
                            Margin="4"
                            Style="{StaticResource Style.RadioButton.Base}"
                            x:Name="radio_button_4096" />
                    </Grid>

                    <!--  Water  -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0.2*" />
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            Margin="5"
                            Style="{StaticResource Style.Text.Light.Header}"
                            Text="WATER" />

                        <Slider
                            Grid.Row="2"
                            Margin="0,4,0,0"
                            Maximum="100"
                            Minimum="0"
                            RenderTransformOrigin="0.5,0.5"
                            Value="50"
                            x:Name="slider_water" />
                    </Grid>

                    <!--  Forest  -->
                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="1.2*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            HorizontalAlignment="Center"
                            Margin="5"
                            Style="{StaticResource Style.Text.Light.Header}"
                            Text="FOREST" />

                        <Slider
                            Grid.Row="1"
                            Margin="0,4,0,0"
                            Maximum="100"
                            Minimum="0"
                            RenderTransformOrigin="0.5,0.5"
                            Value="50"
                            x:Name="slider_forest" />
                    </Grid>

                    <!--  Biome size  -->
                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="1.2*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            HorizontalAlignment="Center"
                            Margin="5"
                            Style="{StaticResource Style.Text.Light.Header}"
                            Text="BIOME SIZE" />


                        <Slider
                            Grid.Row="1"
                            Margin="0,4,0,0"
                            Maximum="100"
                            Minimum="0"
                            RenderTransformOrigin="0.5,0.5"
                            Value="50"
                            x:Name="slider_biome_size" />
                    </Grid>

                    <Button
                        Content="CREATE"
                        Grid.Row="6"
                        Margin="{StaticResource Margin.GridElement}"
                        Style="{StaticResource Style.ButtonBase}"
                        x:Name="button_create" />

                </Grid>
            </Viewbox>

        </Grid>
    </Viewbox>
</UserControl>
