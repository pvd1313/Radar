<UserControl
    d:DesignHeight="480"
    d:DesignWidth="960"
    mc:Ignorable="d"
    x:Class="Beast.Radar.UI.MainHUDView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <noesis:Xaml.Dependencies>
        <noesis:Dependency Source="..\..\..\Texture\Sprite\UI_main\icon_settings.png" />
        <noesis:Dependency Source="..\..\..\Texture\Sprite\UI_main\icon_go.png" />
        <noesis:Dependency Source="..\..\..\Texture\Sprite\UI_main\icon_stay.png" />
        <noesis:Dependency Source="..\..\..\Texture\Sprite\UI_main\icon_path.png" />
    </noesis:Xaml.Dependencies>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Theme\Beast.Radar.UI.Theme.xaml" />
                <ResourceDictionary Source="..\Theme\Beast.Radar.UI.Brushes.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <sys:String x:Key="Path.Icon.Stand">Assets/Texture/Sprite/UI_main/icon_stay.png</sys:String>
            <sys:String x:Key="Path.Icon.Move">Assets/Texture/Sprite/UI_main/icon_go.png</sys:String>
            <sys:String x:Key="Path.Icon.Settings">Assets/Texture/Sprite/UI_main/icon_settings.png</sys:String>
            <sys:String x:Key="Path.Icon.Pathfinding">Assets/Texture/Sprite/UI_main/icon_path.png</sys:String>

        </ResourceDictionary>
    </UserControl.Resources>


    <Grid x:Name="grid_window">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width ="{StaticResource Size.SafeArea.Left}" />
            <ColumnDefinition Width ="*" />
            <ColumnDefinition Width ="{StaticResource Size.SafeArea.Right}" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="25" />
            <RowDefinition Height="75" />
            <RowDefinition Height="*" />
            <RowDefinition Height="100" />
            <RowDefinition Height="0" />
        </Grid.RowDefinitions>

        <!-- Top line -->
        <Rectangle
            Fill="{StaticResource Brush.Panel.Dark.Normal}"
            Grid.Row="0" Grid.ColumnSpan="3"/>

        <TextBlock x:Name="text_time"
                   Grid.Row="0" Grid.Column="1"
                   HorizontalAlignment="Right"
                   Margin="0,0,10,0"
                   Style="{StaticResource Style.Text.Light.Normal}"
                   Text="00:00"
                   VerticalAlignment="Center"/>

        <!-- Buttons -->
        <Button x:Name="button_settings"
                Margin="5,5,0,0"
                Grid.Row="1" Grid.Column="1"
                Style="{StaticResource Style.Button.Icon}"
                Tag="{StaticResource Path.Icon.Settings}"
                Background="{StaticResource Brush.Element.Dark.Normal}"
                Foreground="{StaticResource Brush.Element.Light.Normal}"
                Height="{StaticResource Size.Button.Scale.Small}"
                Width="{StaticResource Size.Button.Scale.Small}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
        </Button>

        <Button x:Name="button_path"
                Margin="55,5,0,0"
                Grid.Row="1" Grid.Column="1"
                Style="{StaticResource Style.Button.Icon}"
                Tag= "{StaticResource Path.Icon.Pathfinding}"
                Background="{StaticResource Brush.Element.Dark.Normal}"
                Foreground="{StaticResource Brush.Element.Light.Normal}"
                BorderBrush="{StaticResource Brush.Accent.Normal}"
                Height="{StaticResource Size.Button.Scale.Small}"
                Width="{StaticResource Size.Button.Scale.Small}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
        </Button>

        <Button x:Name="button_move"
                Style="{StaticResource Style.Button.Icon}"
                Tag="{StaticResource Path.Icon.Move}"
                Background="{StaticResource Brush.Element.Dark.Normal}"
                Foreground="{StaticResource Brush.Element.Light.Normal}"
                Height="55"
                Width="55"
                Margin="0,0,10,10"
                Grid.Row="3" Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom">
        </Button>
    </Grid>

</UserControl>