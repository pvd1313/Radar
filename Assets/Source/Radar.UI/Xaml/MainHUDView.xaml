<UserControl
d:DesignHeight="480"
d:DesignWidth="960"
mc:Ignorable="d"
x:Class="Beast.Radar.UI.MainHUDView"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions"
xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Theme\Beast.Radar.UI.Theme.xaml" />
                <ResourceDictionary Source="..\Theme\Beast.Radar.UI.Brushes.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <ImageBrush x:Key="Brush.Image.Settings" 
                    ImageSource="..\..\..\Texture\Sprite\UI_main\icon_settings.png" 
                    Stretch="UniformToFill" />
            <ImageBrush x:Key="Brush.Image.Path" 
                    ImageSource="..\..\..\Texture\Sprite\UI_main\icon_path.png" 
                    Stretch="UniformToFill" />
            <ImageBrush x:Key="Brush.Image.Move" 
                    ImageSource="..\..\..\Texture\Sprite\UI_main\icon_go.png" 
                    Stretch="UniformToFill" />
            <ImageBrush x:Key="Brush.Image.Stand" 
                    ImageSource="..\..\..\Texture\Sprite\UI_main\icon_stay.png" 
                    Stretch="UniformToFill" />

            <Style
                TargetType="Button"
                x:Key="Style.Button.Alpha">
                <Setter Property="Opacity" Value="1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="TemplateRoot" Opacity="0.7">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation
                                            Storyboard.TargetName="TemplateRoot"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0.85"
                                                Duration="0:0:0.2" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="TemplateRoot"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0.5"
                                                    Duration="0:0:0.2" />   
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                />
                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Margin="{TemplateBinding Padding}" />       
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <SolidColorBrush x:Key="Brush.Button.Path.Background" Color="Transparent" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="25" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Rectangle 
            Fill="{StaticResource Brush.Foreground.Normal}" 
            Grid.Row="0" />

        <TextBlock x:Name="text_time"
            Grid.Row="0"
            HorizontalAlignment="Right"
            Margin="0,0,10,0"
            Style="{StaticResource Style.Text.Normal}"
            Text="00:00"
            VerticalAlignment="Center"/>

        <Button x:Name="button_settings"
            Background="{StaticResource Brush.Element.Light.Active}"
            Foreground="Transparent"
            Style="{StaticResource Style.Button.Alpha}"
            Grid.Row="1"
            Height="50"
            Width="50"
            HorizontalAlignment="Left"
            VerticalAlignment="Top">
            <Button.OpacityMask>
                <StaticResource ResourceKey="Brush.Image.Settings" />
            </Button.OpacityMask>
        </Button>

        <Button x:Name="button_path"
            Style="{StaticResource Style.Button.Alpha}"
            Background="{StaticResource Brush.Element.Light.Active}"
            Grid.Row="1"
            Height="50"
            Width="50"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="55,0,0,0">
            <Button.OpacityMask>
                <StaticResource ResourceKey="Brush.Image.Path" />
            </Button.OpacityMask>
        </Button>

        <Button x:Name="button_move"
             Style="{StaticResource Style.Button.Alpha}"
             Background="{StaticResource Brush.Element.Light.Active}"
             Grid.Row="1"
             Height="100"
             Width="100"
             HorizontalAlignment="Right"
             VerticalAlignment="Bottom"
             Margin="0,0,0,0">
            <Button.OpacityMask>
                <StaticResource ResourceKey="Brush.Image.Move" /> 
            </Button.OpacityMask>
        </Button>


    </Grid>
</UserControl>