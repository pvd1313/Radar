<UserControl
    d:DesignHeight="480"
    d:DesignWidth="960"
    mc:Ignorable="d"
    x:Class="Beast.Radar.UI.LoadingWindowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <noesis:Xaml.Dependencies>
        <noesis:Dependency Source="..\..\..\Texture\Sprite\Screen\loading_screen_background_1.png" />
    </noesis:Xaml.Dependencies>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Theme\Beast.Radar.UI.Theme.xaml" />
                <ResourceDictionary Source="..\Theme\Beast.Radar.UI.Brushes.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="grid">
        <Grid.Background>
            <ImageBrush ImageSource="..\..\..\Texture\Sprite\Screen\loading_screen_background_1.png" Stretch="UniformToFill" />
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Border
                    Background="{StaticResource Brush.Panel.Background}"
                    HorizontalAlignment="Stretch"
                    Margin="{StaticResource Margin.LeftBottomTopBottom}">
                    <TextBlock
                        FontSize="16"
                        Margin="5,3,0,0"
                        Text="Lorem ipsum"
                        TextBlock.Foreground="{StaticResource Brush.Text.Light.Normal}"
                        x:Name="text_log" />
                </Border>
            </Grid>

            <ProgressBar
                Background="{StaticResource Brush.Panel.Background}"
                Grid.Row="1"
                Height="16"
                Margin="{StaticResource Margin.LeftRightBottom}"
                Maximum="1"
                VerticalAlignment="Bottom"
                x:Name="progress_bar" />
        </Grid>

        <TextBlock
            Background="{StaticResource Brush.Panel.Background}"
            FontSize="36"
            Grid.Column="1"
            Margin="{StaticResource Margin.BottomRight}"
            Text="99"
            TextAlignment="Center"
            TextBlock.Foreground="{StaticResource Brush.Text.Light.Normal}"
            VerticalAlignment="Bottom"
            Width="100"
            x:Name="progress_text" />
    </Grid>

</UserControl>
