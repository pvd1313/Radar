<UserControl x:Class = "Beast.Radar.UI.LoadingWindowView"
             xmlns = "http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x = "http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc = "http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d = "http://schemas.microsoft.com/expression/blend/2008"
             xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
             mc:Ignorable = "d"
             d:DesignWidth = "960" d:DesignHeight = "480">

    <noesis:Xaml.Dependencies>
        <noesis:Dependency Source="..\..\..\Texture\Sprite\Screen\loading_screen_background_1.png"/>
    </noesis:Xaml.Dependencies>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Theme\Beast.Radar.UI.Theme.xaml" />
                <ResourceDictionary Source="..\Theme\Beast.Radar.UI.Brushes.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        x:Name = "grid">
        <Grid.Background>
            <ImageBrush  ImageSource="..\..\..\Texture\Sprite\Screen\loading_screen_background_1.png" Stretch="UniformToFill" />
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width = "*" />
            <ColumnDefinition Width = "auto" />
        </Grid.ColumnDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height = "*"/>
                <RowDefinition Height = "auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Border
                    HorizontalAlignment = "Stretch"
                    Margin = "{StaticResource MarginLeftBottomTopBottom}"
                    Background = "{StaticResource Brush.Panel.Background}">
                    <TextBlock
                        x:Name = "text_log"
                        FontSize = "16"
                        Margin = "5 3 0 0"
                        Text = "Lorem ipsum"
                        TextBlock.Foreground = "{StaticResource Brush.Text.Light.Normal}"/>
                </Border>
            </Grid>

            <ProgressBar
                x:Name = "progress_bar"
                Grid.Row = "1"
                Height =  "16"
                Maximum = "1"
                Margin = "{StaticResource MarginLeftRightBottom}"
                VerticalAlignment = "Bottom"
                Background = "{StaticResource Brush.Panel.Background}"/>
        </Grid>

        <TextBlock
            x:Name = "progress_text"
            Grid.Column = "1"
            Text = "99"
            FontSize = "36"
            VerticalAlignment = "Bottom"
            Background = "{StaticResource Brush.Panel.Background}"
            Width = "100"
            Margin = "{StaticResource MarginBottomRight}"
            TextAlignment = "Center"
            TextBlock.Foreground = "{StaticResource Brush.Text.Light.Normal}"/>
    </Grid>

</UserControl>
