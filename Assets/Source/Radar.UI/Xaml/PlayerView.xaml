<UserControl
    IsHitTestVisible="False"
    x:Class="Beast.Radar.UI.PlayerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <noesis:Xaml.Dependencies>
        <noesis:Dependency Source="..\..\..\Texture\Sprite\UI_character\player.png" />
    </noesis:Xaml.Dependencies>

    <UserControl.Resources>
        <ResourceDictionary>
            <sys:Double x:Key="Size.Icon">10</sys:Double>
            <ImageBrush x:Key="Brush.Icon"
                        ImageSource="..\..\..\Texture\Sprite\UI_character\player.png"
                        Stretch="Uniform" />
        </ResourceDictionary>
    </UserControl.Resources>


    <Rectangle x:Name="view_player" RenderTransformOrigin="0.5,0.5"
               Fill="{StaticResource Brush.Icon}"
               Height="{DynamicResource Size.Icon}"
               Width="{DynamicResource Size.Icon}" />
</UserControl>
