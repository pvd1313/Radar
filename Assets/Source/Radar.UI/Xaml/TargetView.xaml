<UserControl
    IsHitTestVisible="False"
    x:Class="Beast.Radar.UI.TargetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions">

    <noesis:Xaml.Dependencies>
        <noesis:Dependency Source="..\..\..\Texture\Sprite\UI_character\target.png" />
    </noesis:Xaml.Dependencies>

    <UserControl.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Theme\Beast.Radar.UI.Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <sys:Double x:Key="Size.Icon">30</sys:Double>

            <sys:Double x:Key="Size.Font">12</sys:Double>

            <ImageBrush
                ImageSource="..\..\..\Texture\Sprite\UI_character\target.png"
                Stretch="Uniform"
                x:Key="Brush.Icon" />

        </ResourceDictionary>
    </UserControl.Resources>

    <Canvas x:Name="canvas_target"  RenderTransformOrigin="0.5,0.75"
            Height="{DynamicResource Size.Icon}" Width="{DynamicResource Size.Icon}" >
        <Grid Height="{DynamicResource Size.Icon}" Width="{DynamicResource Size.Icon}">

            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="5*"/>
                <RowDefinition Height="8*"/>
            </Grid.RowDefinitions>

            <Rectangle Grid.RowSpan="2"
                       Margin="1,1,1,1"
                       Fill="{StaticResource Brush.Panel.Background}"/>

            <TextBlock x:Name="text_distance"
                       Grid.RowSpan="2"
                       Style="{StaticResource Style.Text.Light.Header}"
                       Text="00km"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="{DynamicResource Size.Font}" />

            <Rectangle Grid.Row="2"
                       Fill="{StaticResource Brush.Icon}"
                       MinHeight="1" MinWidth="1">
            </Rectangle>

        </Grid>

    </Canvas>

</UserControl>
