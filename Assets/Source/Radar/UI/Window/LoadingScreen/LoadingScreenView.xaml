<UserControl x:Class="Beast.Radar.UI.LoadingScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             d:DesignWidth="960" d:DesignHeight="480">

    <UserControl.Resources>
        <ResourceDictionary Source = "..\Resources.xaml" />
    </UserControl.Resources>

        <Grid 
            x:Name = "grid" 
            Background = " White">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width = "*" />
            <ColumnDefinition Width = "auto" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height = "*"/>
        </Grid.RowDefinitions>

        <TextBlock 
           x:Name = "progress_text" 
           Grid.Column = "1" 
           Text = "99" 
           FontSize = "36"  
           VerticalAlignment="Bottom"
           Background = "{StaticResource PanelBackground}"
           Width = "100"
           Margin = "{StaticResource MarginBottomRight}"
           TextAlignment = "Center"
           TextBlock.Foreground = "{StaticResource PanelText}"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height = "*"/>
                <RowDefinition Height = "auto"/>
            </Grid.RowDefinitions>

            <Border 
                Width = "400"
                HorizontalAlignment = "Left"
                Margin = "{StaticResource MarginLeftBottomTopBottom}"
                Background = "{StaticResource PanelBackground}"
                BorderBrush="Wheat">

                <TextBlock 
                    x:Name = "text_log" 
                    FontSize = "16"
                    Margin="5 3 0 0"
                    Text = "Lorem ipsum"
                    TextBlock.Foreground = "{StaticResource PanelText}"/>

            </Border>

            <ProgressBar 
                x:Name = "progress_bar" 
                Grid.Row = "1" 
                Height =  "16"
                Maximum = "1"
                Margin = "{StaticResource MarginLeftRightBottom}"
                VerticalAlignment = "Bottom"
                Background = "{StaticResource PanelBackground}"/>
        </Grid>

    </Grid>
    
</UserControl>
