<ResourceDictionary xmlns = "http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x = "http://schemas.microsoft.com/winfx/2006/xaml">
    
    <SolidColorBrush x:Key = "PanelBackground" Color = "#AA000000"/>

    <SolidColorBrush x:Key = "PanelText" Color = "White" />

    <Thickness x:Key = "MarginLeft">10 0 0 0</Thickness>
    <Thickness x:Key = "MarginTop">0 10 0 0</Thickness>
    <Thickness x:Key = "MarginLeftTop">10 10 0 0</Thickness>
    <Thickness x:Key = "MarginTopLeft">10 10 0 0</Thickness>
    <Thickness x:Key = "MarginRight">0 0 10 0</Thickness>
    <Thickness x:Key = "MarginBottom">0 0 0 10</Thickness>
    <Thickness x:Key = "MarginRightBottom">0 0 10 10</Thickness>
    <Thickness x:Key = "MarginBottomRight">0 0 10 10</Thickness>
    <Thickness x:Key = "MarginLeftRightBottom">10 0 10 10</Thickness>
    <Thickness x:Key = "MarginLeftBottom">10 0 0 10</Thickness>
    <Thickness x:Key = "MarginLeftBottomTop">10 10 0 10</Thickness>
    <Thickness x:Key = "MarginLeftBottomTopBottom">10 10 10 10</Thickness>

    <ImageBrush 
        x:Key = "LoadingScreenBackground_1" 
        ImageSource = "..\..\..\..\Texture\LoadingScreen\loading_screen_background_1.png"
        Stretch="UniformToFill"/>

</ResourceDictionary>